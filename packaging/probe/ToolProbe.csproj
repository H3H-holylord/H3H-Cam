<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>H3HCam Tool Probe</AssemblyName>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../windows/ToolPaths.cs" Link="ToolPaths.cs" />
    <Compile Include="../../windows/L.cs" Link="L.cs" />
    <EmbeddedResource Include="../../windows/Localization/*.json" LogicalName="S8Cam.Localization.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
