<Window x:Class="S8Cam.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="H3H Cam 4.0.9" Icon="app.ico" Width="1180" Height="900" MinWidth="1000" MinHeight="680"
 Background="#090F1A" Foreground="#E7F0FF" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True"
 WindowStartupLocation="CenterScreen">
 <Grid Margin="24">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <!-- Заголовок -->
  <Grid Margin="0,0,0,14">
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <Image Source="app.png" Width="42" Height="42" Margin="0,0,14,0" VerticalAlignment="Center"/>
    <StackPanel VerticalAlignment="Center">
     <TextBlock Text="H3H CAM" FontSize="32" FontWeight="Bold"/>
     <TextBlock Text="{DynamicResource s_37ad6203a89e}" Foreground="#42D8B2" FontSize="11" Margin="2,2,0,0"/>
    </StackPanel>
   </StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
    <TextBlock Text="{DynamicResource language_label}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
    <ComboBox x:Name="LanguageChoice" Width="116" Margin="0,0,12,0" FontSize="12" SelectionChanged="LanguageChoice_Changed">
     <ComboBoxItem Content="{DynamicResource language_auto}"/>
     <ComboBoxItem Content="Русский"/>
     <ComboBoxItem Content="English"/>
    </ComboBox>
    <Button x:Name="ModeToggleButton" Content="{DynamicResource s_45e2a6940134}" Click="ModeToggle_Click" Padding="12,6" Margin="0,0,10,0" Background="#162D42" Foreground="#00d2ff" FontWeight="SemiBold" FontSize="12" ToolTip="{DynamicResource s_ab483afe53b9}"/>
    <Border Background="#152C2B" CornerRadius="16" Padding="16,8">
     <TextBlock x:Name="ConnectionLabel" Text="{DynamicResource s_b37981243396}" Foreground="#70E5C3" FontWeight="SemiBold"/>
    </Border>
   </StackPanel>
  </Grid>

  <!-- Панель быстрых профилей качества в 1 клик -->
  <Border x:Name="ProPresetBar" Grid.Row="1" Margin="0,0,0,14" Background="#0C1524" CornerRadius="10" Padding="12,7">
   <Grid>
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="Auto"/>
     <ColumnDefinition Width="*"/>
     <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <TextBlock Text="{DynamicResource s_59dd689c927a}" FontSize="11" FontWeight="Bold" Foreground="#8498B4" VerticalAlignment="Center" Margin="0,0,10,0"/>
    <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <Button x:Name="PresetStreamingBtn" Content="{DynamicResource s_81972542b0e4}" Click="PresetStreaming_Click" Padding="8,5" Margin="0,2,6,2" Background="#162D42" Foreground="#00d2ff" FontSize="11.5" ToolTip="{DynamicResource s_697c7d0f0e9f}"/>
     <Button x:Name="PresetConferenceBtn" Content="{DynamicResource s_661451c0f114}" Click="PresetConference_Click" Padding="8,5" Margin="0,2,6,2" Background="#162D42" Foreground="#70E5C3" FontSize="11.5" ToolTip="{DynamicResource s_42894855e9d4}"/>
     <Button x:Name="PresetProBtn" Content="{DynamicResource s_82d205c49029}" Click="PresetPro_Click" Padding="8,5" Margin="0,2,6,2" Background="#162D42" Foreground="#FFD700" FontSize="11.5" ToolTip="{DynamicResource s_ce2b3c13f7d8}"/>
     <Button x:Name="PresetEcoBtn" Content="{DynamicResource s_fbd463595a6a}" Click="PresetEco_Click" Padding="8,5" Margin="0,2,8,2" Background="#162D42" Foreground="#A8FFB2" FontSize="11.5" ToolTip="{DynamicResource s_49c98556ff02}"/>

     <!-- Разделитель -->
     <Border Width="1" Height="22" Background="#1F364D" Margin="2,2,10,2" VerticalAlignment="Center"/>

     <!-- Пользовательские пресеты -->
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,2">
      <ComboBox x:Name="CustomPresetsCombo" MinWidth="140" MaxWidth="210" Height="27" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11.5" SelectionChanged="CustomPresetsCombo_SelectionChanged" ToolTip="{DynamicResource s_2d48d84c8597}"/>
      <Button x:Name="SavePresetButton" Content="{DynamicResource s_5ee521f44de9}" Click="SavePreset_Click" Padding="8,4" Margin="0,0,4,0" Background="#163A36" Foreground="#70E5C3" FontSize="11.5" ToolTip="{DynamicResource s_321a918f37f8}"/>
      <Button x:Name="DeletePresetButton" Content="🗑️" Click="DeletePreset_Click" Padding="7,4" Margin="0,0,4,0" Background="#2B1822" Foreground="#FF6B6B" FontSize="11.5" ToolTip="{DynamicResource s_b2f3309e95ed}"/>
     </StackPanel>
    </WrapPanel>
    <Button Grid.Column="2" Content="{DynamicResource s_1423783c8125}" Click="OptimizeObs_Click" Padding="10,5" Background="#1B2F44" Foreground="#00e5ff" FontSize="11.5" ToolTip="{DynamicResource s_a5972886b2f5}"/>
   </Grid>
  </Border>

  <!-- Основная рабочая область: Слева Вкладки настроек, Справа Превью и Телеметрия -->
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="1.1*"/>
    <ColumnDefinition Width="18"/>
    <ColumnDefinition Width="*"/>
   </Grid.ColumnDefinitions>

   <!-- Левая колонка: Базовый режим (BasicPanel) или Pro режим (SettingsPanel) -->
   <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="14">
    <Grid>
     <!-- 1. Базовый режим (Basic Mode) -->
     <ScrollViewer x:Name="BasicPanel" VerticalScrollBarVisibility="Auto" Padding="4,4,8,4" Visibility="Collapsed">
      <StackPanel>
       <!-- Карточка устройства -->
       <Border Background="#0C1524" CornerRadius="10" Padding="14" Margin="0,0,0,12" BorderBrush="#1C2E42" BorderThickness="1">
        <StackPanel>
         <DockPanel Margin="0,0,0,6">
          <TextBlock Text="{DynamicResource s_9ba5c8df7afa}" FontSize="12" FontWeight="Bold" Foreground="#42D8B2" VerticalAlignment="Center"/>
          <TextBlock x:Name="BasicTransportBadge" Text="{DynamicResource s_06dd749dee7f}" Foreground="#70E5C3" Background="#162D42" Padding="6,2" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
         </DockPanel>
         <TextBlock x:Name="BasicDeviceNameText" Text="{DynamicResource s_3582cbf15fc8}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
         <TextBlock x:Name="BasicBatteryText" Text="{DynamicResource s_78f56579d505}" Foreground="#BFCDE0" FontSize="12.5" Margin="0,0,0,2"/>
         <TextBlock x:Name="BasicTransportText" Text="{DynamicResource s_befdd34ad631}" Foreground="#8498B4" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
       </Border>

       <TextBlock Text="{DynamicResource s_91da50927c06}" FontSize="11" FontWeight="SemiBold" Foreground="#42D8B2" Margin="0,4,0,6"/>
       <ComboBox x:Name="BasicTransportChoice" SelectedIndex="{Binding SelectedIndex, ElementName=Transport, Mode=TwoWay}" Margin="0,4,0,8">
        <ComboBoxItem Content="{DynamicResource s_81e310817a26}"/>
        <ComboBoxItem Content="{DynamicResource s_42d4da83ae55}"/>
        <ComboBoxItem Content="{DynamicResource s_88d6f0e4a586}"/>
        <ComboBoxItem Content="{DynamicResource s_6d50ae7c1e98}"/>
       </ComboBox>
       <TextBox Text="{Binding Text, ElementName=PhoneIp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" ToolTip="{DynamicResource s_03be1fd3bd6e}">
        <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
         <Setter Property="Visibility" Value="Collapsed"/>
         <Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=Transport}" Value="1"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
        </Style></TextBox.Style>
       </TextBox>
       <Button Content="{DynamicResource s_4f2ca7cc3bf7}" Click="Scan_Click" IsEnabled="{Binding IsEnabled, ElementName=ScanButton}" HorizontalAlignment="Stretch" Margin="0,0,0,6"/>
       <TextBlock Text="{Binding Text, ElementName=DeviceHint}" Foreground="#8498B4" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,16"/>
       <!-- Камера -->
       <TextBlock Text="{DynamicResource s_5d6f264e301f}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
       <ComboBox x:Name="BasicCameraChoice" DisplayMemberPath="DisplayLabel" SelectedValuePath="Key" SelectionChanged="BasicCameraChoice_Changed" Margin="0,0,0,8"/>


       <!-- Ориентация кадра -->
       <TextBlock Text="{DynamicResource s_7f7637a13b77}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
       <UniformGrid Columns="2" Margin="0,0,0,12">
        <RadioButton x:Name="BasicOrientation169" Content="{DynamicResource s_2bcc778d3619}" GroupName="BasicOrientation" Checked="BasicOrientation_Checked" FontSize="12.5" Padding="4,0,0,0" VerticalContentAlignment="Center"/>
        <RadioButton x:Name="BasicOrientation916" Content="📱 9:16 Shorts" GroupName="BasicOrientation" Checked="BasicOrientation_Checked" FontSize="12.5" Padding="4,0,0,0" VerticalContentAlignment="Center"/>
       </UniformGrid>

       <!-- Пресет качества -->
       <TextBlock Text="{DynamicResource s_abca38be83a6}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
       <UniformGrid Columns="2" Margin="0,0,0,12">
        <Button Content="{DynamicResource s_2b89b1281e84}" Click="PresetStreaming_Click" Padding="8,8" Margin="0,0,4,4" Background="#162D42" Foreground="#00d2ff" FontSize="11.5"/>
        <Button Content="{DynamicResource s_2066a9ebe9e5}" Click="PresetConference_Click" Padding="8,8" Margin="4,0,0,4" Background="#162D42" Foreground="#70E5C3" FontSize="11.5"/>
        <Button Content="{DynamicResource s_619076f05638}" Click="PresetPro_Click" Padding="8,8" Margin="0,4,4,0" Background="#162D42" Foreground="#FFD700" FontSize="11.5"/>
        <Button Content="{DynamicResource s_eaa59b65b98b}" Click="PresetEco_Click" Padding="8,8" Margin="4,4,0,0" Background="#162D42" Foreground="#A8FFB2" FontSize="11.5"/>
       </UniformGrid>

       <!-- Быстрые переключатели -->
       <TextBlock Text="{DynamicResource s_5bc7ae052743}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
       <CheckBox x:Name="BasicPreviewCheck" Content="{DynamicResource s_21c8b6e6cc75}" IsChecked="{Binding IsChecked, ElementName=Preview, Mode=TwoWay}" Margin="0,0,0,8"/>
       <CheckBox Content="{DynamicResource s_0076726a226c}" IsChecked="{Binding IsChecked, ElementName=ScreenOff, Mode=TwoWay}" Margin="0,0,0,8"/>
       <CheckBox x:Name="BasicVirtualCamCheck" Content="{DynamicResource s_0a713151cdca}" Click="BasicVirtualCam_Click" Margin="0,0,0,8"/>
       <TextBlock Text="{Binding Text, ElementName=VirtualCamStatusText}" Foreground="{Binding Foreground, ElementName=VirtualCamStatusText}" FontSize="11" TextWrapping="Wrap" Margin="24,-2,0,8"/>
       <Button Content="{Binding Content, ElementName=InstallVirtualCamButton}" Visibility="{Binding Visibility, ElementName=InstallVirtualCamButton}" IsEnabled="{Binding IsEnabled, ElementName=InstallVirtualCamButton}" Click="InstallVirtualCam_Click" HorizontalAlignment="Left" Padding="10,5" Margin="24,0,0,8"/>
       <CheckBox x:Name="BasicSpoutCheck" Content="{DynamicResource s_083c3e6a77fc}" Click="BasicSpout_Click" Margin="0,0,0,8"/>
       <CheckBox x:Name="BasicFaceTrackingCheck" Content="{DynamicResource s_0cdbf83a8925}" Click="BasicFaceTracking_Click" Margin="0,0,0,8"/>
       <CheckBox x:Name="BasicStabilizationCheck" Content="{DynamicResource s_dfa78d932025}" Click="BasicStabilization_Click" Margin="0,0,0,4"/>
       <CheckBox x:Name="BasicSuperSteadyCheck" Content="{DynamicResource s_5e99808b4b3f}" Click="BasicSuperSteady_Click" Margin="20,0,0,14" ToolTip="{DynamicResource s_9fbacf088232}"/>

       <!-- Большая кнопка Старт -->
       <Button x:Name="BasicStartButton" Content="{DynamicResource s_9825166bb975}" Height="50" Background="#1CA989" Foreground="#041C16" FontWeight="Bold" FontSize="16" Click="BasicStart_Click" Margin="0,0,0,10"/>

       <!-- Переход в Pro режим -->
       <Button Content="{DynamicResource s_b14653ac00f1}" Click="ModeToggle_Click" Background="Transparent" Foreground="#42D8B2" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center" FontSize="12" Margin="0,6,0,6"/>
      </StackPanel>
     </ScrollViewer>

     <!-- 2. Расширенный режим (Pro Mode) -->
     <TabControl x:Name="SettingsPanel">

     <!-- Вкладка 1: 🔌 Связь -->
     <TabItem Header="{DynamicResource s_76181f21a3f9}">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,12,8,0">
       <StackPanel>
        <TextBlock Text="{DynamicResource s_879f5d0dc770}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>

        <TextBlock Text="{DynamicResource s_e9ea7558b557}"/>
        <ComboBox x:Name="Transport">
         <ComboBoxItem Content="{DynamicResource s_8776befa2026}"/>
         <ComboBoxItem Content="Wi-Fi · RTP"/>
         <ComboBoxItem Content="{DynamicResource s_48b7281e0873}"/>
         <ComboBoxItem Content="{DynamicResource s_c3ce7edb8574}"/>
        </ComboBox>

        <TextBlock Text="{DynamicResource s_822f9fd9ba2d}"/>
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <ComboBox x:Name="DeviceChoice" DisplayMemberPath="Label" SelectedValuePath="Key" Margin="0,4,8,10"/>
         <Button Grid.Column="1" x:Name="ScanButton" Content="{DynamicResource s_1527932a67cd}" Click="Scan_Click" Margin="0,4,0,10" Padding="16,8"/>
        </Grid>
        <TextBlock x:Name="DeviceHint" Text="{DynamicResource s_742e0018a139}" Foreground="#8498B4" FontSize="11.5" TextWrapping="Wrap" Margin="0,-4,4,10"/>

        <CheckBox x:Name="ScreenOff" Content="{DynamicResource s_ea934cc99add}" Margin="0,0,0,6"/>

        <DockPanel Margin="0,0,0,4">
         <Button x:Name="InstallVirtualCamButton" Content="{DynamicResource s_9cfff5dad91d}" Click="InstallVirtualCam_Click" DockPanel.Dock="Right" Padding="10,4" Margin="6,0,0,0" FontSize="11" Background="#203A4E" Foreground="#70E5C3" Visibility="Collapsed"/>
         <CheckBox x:Name="VirtualCamera" Content="{DynamicResource s_e4185855dc30}" Click="VirtualCamera_Click" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock x:Name="VirtualCamStatusText" Text="{DynamicResource s_6505f9c93157}" Foreground="#8498B4" FontSize="11" Margin="24,-2,0,8" TextWrapping="Wrap"/>

        <CheckBox x:Name="Preview" Content="{DynamicResource s_f3f1f28d95ee}" Checked="Preview_Changed" Unchecked="Preview_Changed" Margin="0,0,0,10"/>

        <TextBlock Text="{DynamicResource s_64c19913330d}" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,6"/>
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel Margin="0,0,4,0"><TextBlock Text="{DynamicResource s_d9e4185810dc}"/><TextBox x:Name="PhoneIp"/></StackPanel>
         <StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBlock Text="{DynamicResource s_d343cbabc004}"/><TextBox x:Name="PcIp"/></StackPanel>
        </Grid>

        <DockPanel Margin="0,4,0,8">
         <Button x:Name="ShowQrButton" Content="{DynamicResource s_814c58d9243b}" Click="ShowQr_Click" DockPanel.Dock="Right" Padding="12,5" FontSize="11" Margin="6,0,0,0" Background="#1B2F44" Foreground="#70E5C3"/>
         <CheckBox x:Name="AutoPcIp" Content="{DynamicResource s_d5b19baa4e01}" Checked="AutoPcIp_Changed" Unchecked="AutoPcIp_Changed" VerticalAlignment="Center"/>
        </DockPanel>

        <TextBlock Text="{DynamicResource s_6ebb7213dc40}" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,6"/>
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel Margin="0,0,3,0"><TextBlock Text="{DynamicResource s_13cbfd09104d}"/><TextBox x:Name="RtpPort"/></StackPanel>
         <StackPanel Grid.Column="1" Margin="3,0,3,0"><TextBlock Text="{DynamicResource s_731d215ad94f}"/><TextBox x:Name="UsbPort"/></StackPanel>
         <StackPanel Grid.Column="2" Margin="3,0,0,0"><TextBlock Text="{DynamicResource s_356707664ea3}"/><TextBox x:Name="ObsPort"/></StackPanel>
        </Grid>

        <TextBlock Text="{DynamicResource s_b1063d2f3130}" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,6"/>
        <CheckBox x:Name="AutoReconnect" Content="{DynamicResource s_856dd46c55d5}" ToolTip="{DynamicResource s_7c28e9eb31d7}" Margin="0,0,0,6"/>
        <CheckBox x:Name="AutoStartOnUsb" Content="{DynamicResource s_b49e97487170}" Margin="0,0,0,6"/>
        <CheckBox x:Name="AutoStart" Content="{DynamicResource s_70c29912bad6}" Margin="0,0,0,6"/>
       </StackPanel>
      </ScrollViewer>
     </TabItem>

     <!-- Вкладка 2: 🎥 Камера -->
     <TabItem Header="{DynamicResource s_e9832701f265}">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,12,8,0">
       <StackPanel>
        <TextBlock Text="{DynamicResource s_094a5a7154ee}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>

        <TextBlock Text="{DynamicResource s_05b653a0de26}"/>
        <ComboBox x:Name="CameraChoice" DisplayMemberPath="DisplayLabel" SelectedValuePath="Key" SelectionChanged="CameraChoice_Changed"/>
        <TextBlock x:Name="CameraHint" Text="{DynamicResource s_3b4ff0e8a258}" Foreground="#8498B4" FontSize="11.5" TextWrapping="Wrap" Margin="0,-2,4,10"/>

        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel Margin="0,0,4,0"><TextBlock Text="{DynamicResource s_adc3b01f3c15}"/><ComboBox x:Name="ResolutionChoice" DisplayMemberPath="Label" SelectionChanged="ResolutionChoice_Changed"/></StackPanel>
         <StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBlock Text="{DynamicResource s_f92764cb0017}"/><ComboBox x:Name="Fps"/></StackPanel>
        </Grid>

        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel Margin="0,0,4,0"><TextBlock Text="{DynamicResource s_fae9840fa218}"/><TextBox x:Name="Bitrate"/></StackPanel>
         <StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBlock Text="{DynamicResource s_70929885dcb0}"/><ComboBox x:Name="CodecChoice">
          <ComboBoxItem Content="{DynamicResource s_f3850b70ea14}"/>
          <ComboBoxItem Content="{DynamicResource s_bfb8c902ff60}"/>
         </ComboBox></StackPanel>
        </Grid>

        <Grid Margin="0,4,0,6">
         <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel Margin="0,0,4,0"><TextBlock Text="{DynamicResource s_2b180be62e35}"/><ComboBox x:Name="ZoomChoice">
          <ComboBoxItem Content="{DynamicResource s_5f433d45971d}"/>
          <ComboBoxItem Content="1.2x"/>
          <ComboBoxItem Content="1.5x"/>
          <ComboBoxItem Content="2.0x"/>
          <ComboBoxItem Content="3.0x"/>
         </ComboBox></StackPanel>
         <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,18,0,0">
          <CheckBox x:Name="Torch" Content="{DynamicResource s_4ede4aebaff6}"/>
         </StackPanel>
        </Grid>

        <WrapPanel Margin="0,2,0,4">
         <CheckBox x:Name="LowLatency" Content="{DynamicResource s_9f7bc0fae112}" Margin="0,0,16,4"/>
         <CheckBox x:Name="ObsOutput" Content="{DynamicResource s_cd0f896777be}" Margin="0,0,16,4"/>
         <CheckBox x:Name="SpoutOutput" Content="{DynamicResource s_e8cd93de7088}" ToolTip="{DynamicResource s_44e325eb1ac3}" Margin="0,0,0,4"/>
        </WrapPanel>
        <Button Content="{DynamicResource s_a6a5806aef00}" Click="OptimizeObs_Click" HorizontalAlignment="Left" Margin="0,0,0,10" Padding="10,4" Background="#142638" Foreground="#00e5ff" FontSize="11" ToolTip="{DynamicResource s_4f37ed7b8e7a}"/>

        <!-- 💎 AI Super Resolution 4K -->
        <Border Background="#0C1524" CornerRadius="8" Padding="10" Margin="0,0,0,10">
         <StackPanel>
          <DockPanel Margin="0,0,0,6">
           <CheckBox x:Name="SuperResolution4KCheck" Content="{DynamicResource gpu_upscale}" FontWeight="SemiBold" Foreground="#42D8B2" VerticalAlignment="Center" ToolTip="{DynamicResource s_a65873a5115e}"/>
           <TextBlock Text="Direct3D 11" Foreground="#00FFB2" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </DockPanel>
          <DockPanel Margin="0,2,0,2">
           <TextBlock Text="{DynamicResource s_b8d557c98ae0}" FontSize="11.5" Foreground="#8498B4" VerticalAlignment="Center"/>
           <TextBlock x:Name="SuperResolutionSharpnessText" Text="20%" Foreground="#42D8B2" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
          </DockPanel>
          <Slider x:Name="SuperResolutionSharpnessSlider" Minimum="0.0" Maximum="0.50" Value="0.20" SmallChange="0.02" LargeChange="0.10" ValueChanged="SuperResolutionSharpnessSlider_ValueChanged"/>
         </StackPanel>
        </Border>

        <TextBlock Text="{DynamicResource s_b2386586742f}" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,8"/>

        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel Margin="0,0,4,0"><TextBlock Text="{DynamicResource s_92b9fcc46d13}"/><ComboBox x:Name="FocusMode">
          <ComboBoxItem Content="{DynamicResource s_8d4b6715352f}"/><ComboBoxItem Content="{DynamicResource s_b9dadbe2331d}"/><ComboBoxItem Content="{DynamicResource s_8b4909063aeb}"/><ComboBoxItem Content="{DynamicResource s_2a3fe0963579}"/>
         </ComboBox></StackPanel>
         <StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBlock Text="{DynamicResource s_5bdbc2794c58}"/><TextBox x:Name="FocusDistance"/></StackPanel>
        </Grid>

        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel Margin="0,0,4,0"><TextBlock Text="{DynamicResource s_8844d7240f06}"/><ComboBox x:Name="ShutterChoice">
          <ComboBoxItem Content="{DynamicResource s_d2ffd319a26c}"/>
          <ComboBoxItem Content="{DynamicResource s_75163c9e9490}"/>
          <ComboBoxItem Content="{DynamicResource s_b05d2374f004}"/>
          <ComboBoxItem Content="{DynamicResource s_80f9eaf6f889}"/>
          <ComboBoxItem Content="{DynamicResource s_0d7710e90c42}"/>
          <ComboBoxItem Content="{DynamicResource s_fe437ea2cc87}"/>
          <ComboBoxItem Content="{DynamicResource s_3f9fabcbf2e4}"/>
          <ComboBoxItem Content="{DynamicResource s_86d36de88f4c}"/>
          <ComboBoxItem Content="{DynamicResource s_1762a8aaa529}"/>
          <ComboBoxItem Content="{DynamicResource s_9d00170362ee}"/>
          <ComboBoxItem Content="{DynamicResource s_b10af6bd831a}"/>
         </ComboBox></StackPanel>
         <StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBlock Text="{DynamicResource s_77062fdff1f4}"/><ComboBox x:Name="IsoChoice">
          <ComboBoxItem Content="{DynamicResource s_0acabd68f89f}"/>
          <ComboBoxItem Content="{DynamicResource s_73dedd034ce7}"/>
          <ComboBoxItem Content="{DynamicResource s_493cf6643d68}"/>
          <ComboBoxItem Content="{DynamicResource s_7e66fe242cf7}"/>
          <ComboBoxItem Content="{DynamicResource s_39a2ba07e7dd}"/>
          <ComboBoxItem Content="{DynamicResource s_5ee3c2a142f3}"/>
          <ComboBoxItem Content="{DynamicResource s_da320cec5137}"/>
          <ComboBoxItem Content="{DynamicResource s_90af2f8d334c}"/>
         </ComboBox></StackPanel>
        </Grid>

        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel Margin="0,0,4,0"><TextBlock Text="{DynamicResource s_298819e7042d}"/><ComboBox x:Name="WbKelvinChoice">
