          <StackPanel>
           <DockPanel Margin="0,0,0,6">
            <TextBlock Text="🎬 Автоматизация OBS Studio &amp; Мультикам" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
