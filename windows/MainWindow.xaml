          <TextBlock Text="Пустой путь = автоматический поиск" Foreground="#8498B4" Margin="0,0,0,8"/>
          <TextBlock Text="adb.exe"/><DockPanel><Button Content="…" DockPanel.Dock="Right" Tag="AdbPath" Click="Browse_Click"/><TextBox x:Name="AdbPath"/></DockPanel>
          <TextBlock Text="ffmpeg.exe"/><DockPanel><Button Content="…" DockPanel.Dock="Right" Tag="FfmpegPath" Click="Browse_Click"/><TextBox x:Name="FfmpegPath"/></DockPanel>
          <TextBlock Text="ffplay.exe"/><DockPanel><Button Content="…" DockPanel.Dock="Right" Tag="FfplayPath" Click="Browse_Click"/><TextBox x:Name="FfplayPath"/></DockPanel>
          <TextBlock Text="obs64.exe"/><DockPanel><Button Content="…" DockPanel.Dock="Right" Tag="ObsPath" Click="Browse_Click"/><TextBox x:Name="ObsPath"/></DockPanel>
          <TextBlock Text="Preview UDP порт"/><TextBox x:Name="PreviewPort"/>
          <CheckBox x:Name="ForceSamsungLegacy" Content="Принудительный Samsung 60 FPS backend (для Exynos)" Foreground="#8498B4" Margin="0,8,0,0"/>
         </StackPanel>
        </Expander>
       </StackPanel>
      </ScrollViewer>
     </TabItem>

    </TabControl>
    </Grid>
   </Border>

   <!-- Правая колонка: Информационная панель, Превью и Журнал -->
   <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid>
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Карточка 1: Видеопоток и живое превью -->
    <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="20" Margin="0,0,0,14">
     <StackPanel>
      <TextBlock Text="Поток" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock x:Name="StateText" Text="Остановлено" Foreground="#70E5C3" Margin="0,8,0,12" TextWrapping="Wrap"/>
      <UniformGrid Columns="2">
       <StackPanel Margin="0,0,0,12"><TextBlock Text="ПОЛУЧЕНО" Foreground="#8498B4" FontSize="11"/><TextBlock x:Name="RateText" Text="0.00 Mbps" FontSize="26"/></StackPanel>
       <StackPanel Margin="0,0,0,12"><TextBlock Text="ФАКТ / ЗАПРОС" Foreground="#8498B4" FontSize="11"/><TextBlock x:Name="FpsText" Text="— / 30 fps" FontSize="26"/></StackPanel>
      </UniformGrid>
      <TextBlock x:Name="TechnicalText" Text="Подключение —  ·  Камера —&#10;FFmpeg остановлен  ·  00:00:00" LineHeight="22" TextWrapping="Wrap"/>

      <!-- Живой интерактивный предпросмотр прямо в окне -->
      <Border x:Name="PreviewContainer" Background="#060B12" BorderBrush="#1C2E42" BorderThickness="1" CornerRadius="8" Height="250" Margin="0,10,0,4" ClipToBounds="True" MouseWheel="VideoPreview_MouseWheel">
       <Grid MouseWheel="VideoPreview_MouseWheel">
        <!-- Кадр видеопотока -->
        <Image x:Name="LivePreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality" MouseDown="VideoPreview_MouseDown" MouseWheel="VideoPreview_MouseWheel" Cursor="Cross"/>

        <!-- Заглушка до запуска -->
        <Grid x:Name="PreviewPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
         <StackPanel HorizontalAlignment="Center">
          <TextBlock Text="📹" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,6" Opacity="0.4"/>
          <TextBlock Text="Предпросмотр камеры появится при запуске потока" Foreground="#8498B4" FontSize="12" HorizontalAlignment="Center"/>
          <TextBlock Text="🎯 Кликните прямо по объекту на видео для фокусировки" Foreground="#42D8B2" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center"/>
         </StackPanel>
        </Grid>

        <!-- Слой анимации прицела автофокуса (Canvas) -->
        <Canvas x:Name="FocusCanvas" ClipToBounds="True" IsHitTestVisible="False"/>

        <!-- Слой направляющих сетки композиции (Rule of Thirds) -->
        <Canvas x:Name="GridCanvas" ClipToBounds="True" IsHitTestVisible="False" Visibility="Collapsed" SizeChanged="GridCanvas_SizeChanged"/>

        <!-- Слой рамки лица и зоны кропа авто-фрейминга (NVIDIA Broadcast style) -->
        <Canvas x:Name="FaceCanvas" ClipToBounds="True" IsHitTestVisible="False"/>

        <!-- Индикатор зоны калибровки баланса белого по белому листу бумаги -->
        <Border x:Name="WbTargetBox" Width="120" Height="90" BorderBrush="#00FFB2" BorderThickness="1.5" CornerRadius="6" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False">
         <Border.Effect>
          <DropShadowEffect Color="#00FFB2" BlurRadius="10" ShadowDepth="0" Opacity="0.7"/>
         </Border.Effect>
         <TextBlock x:Name="WbTargetBoxText" Text="🎯 Белый лист" Foreground="#00FFB2" FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2" Background="#D9090F1A" Padding="4,1"/>
        </Border>

        <!-- Вспышка затвора при создании снимка -->
        <Border x:Name="CameraFlashOverlay" Background="White" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

        <!-- Нижняя подсказка -->
        <Border VerticalAlignment="Bottom" Background="#B3090F1A" Padding="6,3" IsHitTestVisible="False">
         <TextBlock Text="🎯 Клик: фокус  ·  Колёсико: зум  ·  Ср. клик / 2x: 1.0x" Foreground="#42D8B2" FontSize="10" HorizontalAlignment="Center"/>
        </Border>
       </Grid>
      </Border>

      <Expander Header="Инструменты кадра" Foreground="#BFCDE0" Margin="0,6,0,0">        <!-- Панель управления поверх видео: бейдж и кнопки -->
        <WrapPanel Margin="0,6,0,6">
         <WrapPanel>
          <Border x:Name="ResolutionBadgeBorder" Visibility="Collapsed" Background="#D9090F1A" CornerRadius="4" Padding="6,2" Margin="0,0,4,0">
           <TextBlock x:Name="PreviewResolutionBadge" Text="1920×1080" Foreground="#70E5C3" FontSize="10" FontWeight="SemiBold"/>
          </Border>
          <Border x:Name="RecBadgeBorder" Visibility="Collapsed" Background="#D9E02424" CornerRadius="4" Padding="6,2">
           <TextBlock x:Name="RecBadgeText" Text="🔴 REC 00:00" Foreground="White" FontSize="10" FontWeight="Bold"/>
          </Border>
         </WrapPanel>
         <WrapPanel>
          <Button x:Name="SnapshotButton" Content="📸 СНИМОК" Padding="7,5" FontSize="11" Margin="0,0,2,0" Click="Snapshot_Click" Background="#1C2E42" Foreground="#70E5C3" ToolTip="Моментальный 4K/UHD снимок в папку Изображения/H3HCam (F9 / Ctrl+S)"/>
          <Button x:Name="RecordButton" Content="🔴 ЗАПИСЬ" Padding="7,5" FontSize="11" Margin="0,0,5,0" Click="Record_Click" Background="#2A141A" Foreground="#FF6B8B" ToolTip="Локальная запись прямого MP4-потока без нагрузки на процессор (F10 / Ctrl+R)"/>
          <Button x:Name="LensWideButton" Content="0.6x" Padding="7,5" FontSize="11" Margin="0,0,2,0" Click="LensWide_Click" Background="#1C2E42" Foreground="#70E5C3" ToolTip="Быстрое переключение на ультраширокоугольный объектив (0.6x UltraWide) на лету"/>
          <Button x:Name="LensMainButton" Content="1.0x" Padding="7,5" FontSize="11" Margin="0,0,2,0" Click="LensMain_Click" Background="#1C2E42" Foreground="#70E5C3" ToolTip="Быстрое переключение на основной объектив (1.0x Main) на лету"/>
          <Button x:Name="LensTeleButton" Content="2.0x" Padding="7,5" FontSize="11" Margin="0,0,5,0" Click="LensTele_Click" Background="#1C2E42" Foreground="#70E5C3" ToolTip="Быстрое переключение на телеобъектив (2.0x / 3.0x Telephoto) на лету"/>
          <Button x:Name="GridButton" Content="📐 GRID" Padding="7,5" FontSize="11" Margin="0,0,2,0" Click="Grid_Click" Background="#152435" Foreground="#8498B4" ToolTip="Направляющие сетки композиции: линии третей (Rule of Thirds), уровень глаз и рамка 9:16 Shorts"/>
          <Button x:Name="PeakButton" Content="🔍 PEAK" Padding="7,5" FontSize="11" Margin="0,0,2,0" Click="Peak_Click" Background="#152435" Foreground="#8498B4" ToolTip="Focus Peaking: подсветка контуров резкости для ручной фокусировки"/>
          <Button x:Name="ZebraButton" Content="🦓 ZEBRA" Padding="7,5" FontSize="11" Margin="0,0,2,0" Click="Zebra_Click" Background="#152435" Foreground="#8498B4" ToolTip="Zebra Pattern: индикатор зон пересвета (&gt;95% яркости)"/>
          <Button x:Name="AutoFramingButton" Content="🤖 CENTER" Padding="7,5" FontSize="11" Margin="0,0,2,0" Click="AutoFraming_Click" Background="#152435" Foreground="#8498B4" ToolTip="Включение / выключение авто-кадрирования Center Stage (плавное следование за лицом)"/>
          <Button x:Name="FaceTrackingButton" Content="👤 FACE" Padding="7,5" FontSize="11" Margin="0,0,2,0" Click="FaceTracking_Click" Background="#152435" Foreground="#8498B4" ToolTip="Включение / выключение аппаратного отслеживания лиц (Face Priority AF)"/>
          <Button x:Name="FaceOverlayButton" Content="🎯 BOX" Padding="7,5" FontSize="11" Margin="0,0,2,0" Click="FaceOverlay_Click" Background="#152435" Foreground="#70E5C3" ToolTip="Визуализация рамки лица и зоны авто-фрейминга (NVIDIA Broadcast style)"/>
          <Button x:Name="LockAeAwbButton" Content="🔓 AE/AWB" Padding="7,5" FontSize="11" Margin="0,0,2,0" Click="LockAeAwb_Click" Background="#152435" Foreground="#8498B4" ToolTip="Быстрая фиксация/разблокировка автоэкспозиции и баланса белого"/>
          <Button x:Name="QuickWbButton" Content="📄 WB" Padding="7,5" FontSize="11" Margin="0,0,2,0" Click="CalibrateWb_Click" Background="#152435" Foreground="#8498B4" ToolTip="Быстрая калибровка баланса белого по листу бумаги"/>
          <Button x:Name="PopoutPreviewButton" Content="⛶ ОКНО" Padding="7,5" FontSize="11" Margin="0,0,2,0" Click="PopoutPreview_Click" Background="#1C2E42" Foreground="#E7F0FF" ToolTip="Открыть предпросмотр в отдельном окне с фокусировкой"/>
          <Button x:Name="FfplayButton" Content="ffplay" Padding="7,5" FontSize="11" Click="Ffplay_Click" Background="#152435" Foreground="#8498B4" ToolTip="Запустить внешний плеер ffplay"/>
         </WrapPanel>
        </WrapPanel>

</Expander>
      <TextBlock x:Name="DetailText" Foreground="#8498B4" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"/>
     </StackPanel>
    </Border>

    <!-- Карточка 2: Телеметрия батареи и график -->
    <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16" Margin="0,0,0,14">
     <StackPanel>
      <DockPanel><TextBlock Text="Питание телефона" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="PowerSourceText" Text="N/A" Foreground="#8498B4" HorizontalAlignment="Right"/></DockPanel>
      <TextBlock x:Name="PowerHeadlineText" Text="N/A  •  N/A" FontSize="21" Foreground="#70E5C3" Margin="0,6,0,2"/>
      <TextBlock x:Name="PowerQuickText" Text="Battery voltage N/A  ·  Current N/A  ·  Power N/A  ·  Temperature N/A" Foreground="#BFCDE0" FontSize="12.5" TextWrapping="Wrap"/>
      <TextBlock x:Name="PowerWarningText" Text="Оценка появится после запуска" Foreground="#E6B85C" FontSize="11.5" Margin="0,5,0,0" TextWrapping="Wrap"/>
      <Canvas x:Name="PowerChart" Height="45" Margin="0,6,0,0" ClipToBounds="True" SizeChanged="PowerChart_SizeChanged" Background="#0C1421"/>
      <TextBlock Text="Зелёный: заряд  ·  Красный: °C  ·  Голубой: ток  ·  Жёлтый: мощность · последние 60 минут" Foreground="#687C98" FontSize="10" Margin="0,3,0,0"/>
      <Expander Header="Подробные данные батареи" Foreground="#BFCDE0" Margin="0,4,0,0">
       <TextBlock x:Name="PowerDetailsText" Text="N/A" FontFamily="Consolas" FontSize="11" LineHeight="17" Margin="0,6,0,0"/>
      </Expander>
     </StackPanel>
    </Border>

    <!-- Карточка 3: Журнал событий -->
    <Border MinHeight="180" Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="18">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,10">
       <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
        <Button Content="📋 ОТЧЁТ" Padding="8,4" Margin="0,0,4,0" Click="CopyDiagnostics_Click" FontSize="10.5" ToolTip="Скопировать структурированный отчёт о системе, камере, соединении и AI в буфер обмена"/>
        <Button Content="📁 ЛОГИ" Padding="8,4" Margin="0,0,4,0" Click="OpenLogsFolder_Click" FontSize="10.5" ToolTip="Открыть папку с ежедневными логами %LocalAppData%\H3HCam\logs"/>
        <Button Content="⚠️ ОШИБКИ" Padding="8,4" Margin="0,0,4,0" Click="CopyLastErrors_Click" FontSize="10.5" ToolTip="Скопировать последние ошибки из лога"/>
        <Button Content="📦 ZIP" Padding="8,4" Margin="0,0,4,0" Click="ExportDiagnostics_Click" FontSize="10.5" ToolTip="Экспорт полного архива диагностики (.zip)"/>
        <Button Content="🧹 ОЧИСТИТЬ" Padding="8,4" Click="ClearLog_Click" FontSize="10.5"/>
       </StackPanel>
       <TextBlock Text="Журнал" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </DockPanel>
      <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11.5" BorderThickness="0" Margin="0" Background="#0C1421"/>
     </Grid>
    </Border>
   </Grid></ScrollViewer>
  </Grid>

  <!-- Нижняя панель действий -->
  <WrapPanel Grid.Row="3" Orientation="Horizontal" Margin="0,18,0,0">
   <Button x:Name="StartButton" Content="▶  СТАРТ" Background="#1CA989" Foreground="#041C16" FontWeight="Bold" Width="135" Click="Start_Click"/>
   <Button x:Name="ApplyButton" Content="↻  ПРИМЕНИТЬ" Width="145" IsEnabled="False" Click="Apply_Click"/>
   <Button x:Name="StopButton" Content="■  СТОП" Width="110" IsEnabled="False" Click="Stop_Click"/>
   <Button x:Name="PrivacyMuteButton" Content="🔒 MUTE" Width="95" ToolTip="Приостановить передачу новых кадров на всех выходах. Получатели могут удерживать последний кадр." Click="PrivacyMute_Click"/>
   <Button x:Name="StreamHudButton" Content="📊 STREAM HUD" Click="ToggleHud_Click" Padding="12,8" Margin="0,0,6,0" Background="#152435" Foreground="#70E5C3" ToolTip="Открыть плавающий полупрозрачный оверлей с живыми метриками (FPS, битрейт, задержка, батарея)"/>
   <Button x:Name="TestButton" Content="ПОЛНАЯ ПРОВЕРКА" Click="Test_Click"/>
    <Button Content="USB · 60 FPS" Click="Usb60_Click" Visibility="{Binding Visibility, ElementName=ProPresetBar}"/>
    <Button Content="ТЕСТ ЗАДЕРЖКИ" Click="LatencyTest_Click" Visibility="{Binding Visibility, ElementName=ProPresetBar}"/>
   <Button Content="Открыть OBS" Click="Obs_Click"/>
  </WrapPanel>

  <!-- Модальное окно сохранения пресета -->
  <Grid x:Name="SavePresetModal" Grid.Row="0" Grid.RowSpan="4" Margin="-24" Background="#D8050B14" Visibility="Collapsed" Panel.ZIndex="1000">
   <Border Width="450" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#0C1524" BorderBrush="#00d2ff" BorderThickness="1.5" CornerRadius="12" Padding="22">
    <StackPanel>
     <TextBlock Text="💾 Сохранение пресета" FontSize="16" FontWeight="Bold" Foreground="#E7F0FF" Margin="0,0,0,8"/>
     <TextBlock Text="Текущие настройки видео, качества, кодека, эффектов, стабилизации и экспозиции будут сохранены в ваш профиль." FontSize="11.5" Foreground="#8498B4" TextWrapping="Wrap" Margin="0,0,0,16"/>
     <TextBlock Text="Название пресета:" FontSize="12" FontWeight="SemiBold" Foreground="#70E5C3" Margin="0,0,0,6"/>
     <TextBox x:Name="PresetNameInput" Text="Мой пресет" Height="34" VerticalContentAlignment="Center" Padding="10,4" Background="#16263B" Foreground="#E7F0FF" BorderBrush="#2D4665" FontSize="13" Margin="0,0,0,18" KeyDown="PresetNameInput_KeyDown"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Отмена" Click="CancelSavePreset_Click" Padding="14,6" Margin="0,0,8,0" Background="#1B2F44" Foreground="#8498B4" FontSize="12"/>
      <Button Content="💾 Сохранить" Click="ConfirmSavePreset_Click" Padding="14,6" Background="#163A36" Foreground="#70E5C3" FontWeight="Bold" FontSize="12"/>
     </StackPanel>
    </StackPanel>
   </Border>
  </Grid>
 </Grid>
</Window>
