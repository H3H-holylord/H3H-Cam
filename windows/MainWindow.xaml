            </StackPanel>
            <Button Grid.Column="1" Content="+ Камера #2" Click="LaunchSecondCamera_Click" VerticalAlignment="Bottom" Padding="11,6" Margin="0" FontSize="11.5"/>
           </Grid>

           <CheckBox x:Name="ObsWsEnabledCheck" Content="Подключить OBS WebSocket v5 (живой Tally «В ЭФИРЕ» и управление)" Checked="ObsWsToggle_Changed" Unchecked="ObsWsToggle_Changed"/>

           <Grid Margin="0,2,0,2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,4,0">
             <TextBlock Text="Адрес OBS WebSocket" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
             <TextBox x:Name="ObsWsUrlBox" Text="ws://127.0.0.1:4455"/>
