          <TextBlock Text="{DynamicResource s_4eb00f95c854}" Foreground="#8498B4" FontSize="12" HorizontalAlignment="Center"/>
          <TextBlock Text="{DynamicResource s_fa1c7d726b30}" Foreground="#42D8B2" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center"/>
         </StackPanel>
        </Grid>

        <!-- Слой анимации прицела автофокуса (Canvas) -->
        <Canvas x:Name="FocusCanvas" ClipToBounds="True" IsHitTestVisible="False"/>

        <!-- Слой направляющих сетки композиции (Rule of Thirds) -->
        <Canvas x:Name="GridCanvas" ClipToBounds="True" IsHitTestVisible="False" Visibility="Collapsed" SizeChanged="GridCanvas_SizeChanged"/>

        <!-- Слой рамки лица и зоны кропа авто-фрейминга (NVIDIA Broadcast style) -->
        <Canvas x:Name="FaceCanvas" ClipToBounds="True" IsHitTestVisible="False"/>

        <!-- Индикатор зоны калибровки баланса белого по белому листу бумаги -->
        <Border x:Name="WbTargetBox" Width="120" Height="90" BorderBrush="#00FFB2" BorderThickness="1.5" CornerRadius="6" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False">
         <Border.Effect>
          <DropShadowEffect Color="#00FFB2" BlurRadius="10" ShadowDepth="0" Opacity="0.7"/>
         </Border.Effect>
         <TextBlock x:Name="WbTargetBoxText" Text="{DynamicResource s_85e2d3a5748f}" Foreground="#00FFB2" FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2" Background="#D9090F1A" Padding="4,1"/>
        </Border>

        <!-- Вспышка затвора при создании снимка -->
        <Border x:Name="CameraFlashOverlay" Background="White" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

        <!-- Нижняя подсказка -->
        <Border VerticalAlignment="Bottom" Background="#B3090F1A" Padding="6,3" IsHitTestVisible="False">
         <TextBlock Text="{DynamicResource s_1469f5b2a80b}" Foreground="#42D8B2" FontSize="10" HorizontalAlignment="Center"/>
        </Border>
       </Grid>
      </Border>

      <Expander Header="{DynamicResource s_47b58657842e}" Foreground="#BFCDE0" Margin="0,6,0,0">        <!-- Панель управления поверх видео: бейдж и кнопки -->
        <WrapPanel Margin="0,6,0,6">
         <WrapPanel>
          <Border x:Name="ResolutionBadgeBorder" Visibility="Collapsed" Background="#D9090F1A" CornerRadius="4" Padding="6,2" Margin="0,0,4,0">
           <TextBlock x:Name="PreviewResolutionBadge" Text="1920×1080" Foreground="#70E5C3" FontSize="10" FontWeight="SemiBold"/>
          </Border>
          <Border x:Name="RecBadgeBorder" Visibility="Collapsed" Background="#D9E02424" CornerRadius="4" Padding="6,2">
           <TextBlock x:Name="RecBadgeText" Text="🔴 REC 00:00" Foreground="White" FontSize="10" FontWeight="Bold"/>
          </Border>
         </WrapPanel>
         <WrapPanel>
          <Button x:Name="SnapshotButton" Content="{DynamicResource s_3d7e3f5b1a17}" Padding="7,5" FontSize="11" Margin="0,0,2,0" Click="Snapshot_Click" Background="#1C2E42" Foreground="#70E5C3" ToolTip="{DynamicResource s_a24cda0bd19d}"/>
          <Button x:Name="RecordButton" Content="{DynamicResource s_70c75c89eb79}" Padding="7,5" FontSize="11" Margin="0,0,5,0" Click="Record_Click" Background="#2A141A" Foreground="#FF6B8B" ToolTip="{DynamicResource s_fe554d1c0419}"/>
          <Button x:Name="LensWideButton" Content="0.6x" Padding="7,5" FontSize="11" Margin="0,0,2,0" Click="LensWide_Click" Background="#1C2E42" Foreground="#70E5C3" ToolTip="{DynamicResource s_93f7f620cdae}"/>
          <Button x:Name="LensMainButton" Content="1.0x" Padding="7,5" FontSize="11" Margin="0,0,2,0" Click="LensMain_Click" Background="#1C2E42" Foreground="#70E5C3" ToolTip="{DynamicResource s_518e154c4dbe}"/>
          <Button x:Name="LensTeleButton" Content="2.0x" Padding="7,5" FontSize="11" Margin="0,0,5,0" Click="LensTele_Click" Background="#1C2E42" Foreground="#70E5C3" ToolTip="{DynamicResource s_f2b6d6510258}"/>
          <Button x:Name="GridButton" Content="📐 GRID" Padding="7,5" FontSize="11" Margin="0,0,2,0" Click="Grid_Click" Background="#152435" Foreground="#8498B4" ToolTip="{DynamicResource s_b6b7e8d1276d}"/>
          <Button x:Name="PeakButton" Content="🔍 PEAK" Padding="7,5" FontSize="11" Margin="0,0,2,0" Click="Peak_Click" Background="#152435" Foreground="#8498B4" ToolTip="{DynamicResource s_a5350a30942c}"/>
          <Button x:Name="ZebraButton" Content="🦓 ZEBRA" Padding="7,5" FontSize="11" Margin="0,0,2,0" Click="Zebra_Click" Background="#152435" Foreground="#8498B4" ToolTip="{DynamicResource s_787448f22452}"/>
          <Button x:Name="AutoFramingButton" Content="🤖 CENTER" Padding="7,5" FontSize="11" Margin="0,0,2,0" Click="AutoFraming_Click" Background="#152435" Foreground="#8498B4" ToolTip="{DynamicResource s_a6e3bb46b89d}"/>
          <Button x:Name="FaceTrackingButton" Content="👤 FACE" Padding="7,5" FontSize="11" Margin="0,0,2,0" Click="FaceTracking_Click" Background="#152435" Foreground="#8498B4" ToolTip="{DynamicResource s_4814ff102c60}"/>
          <Button x:Name="FaceOverlayButton" Content="🎯 BOX" Padding="7,5" FontSize="11" Margin="0,0,2,0" Click="FaceOverlay_Click" Background="#152435" Foreground="#70E5C3" ToolTip="{DynamicResource s_5b9a76113ad5}"/>
          <Button x:Name="LockAeAwbButton" Content="🔓 AE/AWB" Padding="7,5" FontSize="11" Margin="0,0,2,0" Click="LockAeAwb_Click" Background="#152435" Foreground="#8498B4" ToolTip="{DynamicResource s_ec1de973f6a2}"/>
          <Button x:Name="QuickWbButton" Content="📄 WB" Padding="7,5" FontSize="11" Margin="0,0,2,0" Click="CalibrateWb_Click" Background="#152435" Foreground="#8498B4" ToolTip="{DynamicResource s_8268d14811d3}"/>
          <Button x:Name="PopoutPreviewButton" Content="{DynamicResource s_4c39c8966302}" Padding="7,5" FontSize="11" Margin="0,0,2,0" Click="PopoutPreview_Click" Background="#1C2E42" Foreground="#E7F0FF" ToolTip="{DynamicResource s_3bff217e3905}"/>
          <Button x:Name="FfplayButton" Content="ffplay" Padding="7,5" FontSize="11" Click="Ffplay_Click" Background="#152435" Foreground="#8498B4" ToolTip="{DynamicResource s_7326dc1bbfb9}"/>
         </WrapPanel>
        </WrapPanel>

</Expander>
      <TextBlock x:Name="DetailText" Foreground="#8498B4" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"/>
     </StackPanel>
    </Border>

    <!-- Карточка 2: Телеметрия батареи и график -->
    <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16" Margin="0,0,0,14">
     <StackPanel>
      <DockPanel><TextBlock Text="{DynamicResource s_ada21f57d547}" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="PowerSourceText" Text="N/A" Foreground="#8498B4" HorizontalAlignment="Right"/></DockPanel>
      <TextBlock x:Name="PowerHeadlineText" Text="N/A  •  N/A" FontSize="21" Foreground="#70E5C3" Margin="0,6,0,2"/>
      <TextBlock x:Name="PowerQuickText" Text="Battery voltage N/A  ·  Current N/A  ·  Power N/A  ·  Temperature N/A" Foreground="#BFCDE0" FontSize="12.5" TextWrapping="Wrap"/>
      <TextBlock x:Name="PowerWarningText" Text="{DynamicResource s_ac6524c18735}" Foreground="#E6B85C" FontSize="11.5" Margin="0,5,0,0" TextWrapping="Wrap"/>
      <Canvas x:Name="PowerChart" Height="45" Margin="0,6,0,0" ClipToBounds="True" SizeChanged="PowerChart_SizeChanged" Background="#0C1421"/>
      <TextBlock Text="{DynamicResource s_d2901c8fae3f}" Foreground="#687C98" FontSize="10" Margin="0,3,0,0"/>
      <Expander Header="{DynamicResource s_bd56e377a50a}" Foreground="#BFCDE0" Margin="0,4,0,0">
       <TextBlock x:Name="PowerDetailsText" Text="N/A" FontFamily="Consolas" FontSize="11" LineHeight="17" Margin="0,6,0,0"/>
      </Expander>
     </StackPanel>
    </Border>

    <!-- Карточка 3: Журнал событий -->
    <Border MinHeight="180" Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="18">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,10">
       <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
        <Button Content="{DynamicResource s_c27caba688b1}" Padding="8,4" Margin="0,0,4,0" Click="CopyDiagnostics_Click" FontSize="10.5" ToolTip="{DynamicResource s_d52a5c964c87}"/>
        <Button Content="{DynamicResource s_4bd70174370f}" Padding="8,4" Margin="0,0,4,0" Click="OpenLogsFolder_Click" FontSize="10.5" ToolTip="{DynamicResource s_4fd11f0e280c}"/>
        <Button Content="{DynamicResource s_a04d10c3daaf}" Padding="8,4" Margin="0,0,4,0" Click="CopyLastErrors_Click" FontSize="10.5" ToolTip="{DynamicResource s_162e2366d4e0}"/>
        <Button Content="📦 ZIP" Padding="8,4" Margin="0,0,4,0" Click="ExportDiagnostics_Click" FontSize="10.5" ToolTip="{DynamicResource s_c956d7a97396}"/>
        <Button Content="{DynamicResource s_70977f4262cf}" Padding="8,4" Click="ClearLog_Click" FontSize="10.5"/>
       </StackPanel>
       <TextBlock Text="{DynamicResource s_97c459a6bb7c}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </DockPanel>
      <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11.5" BorderThickness="0" Margin="0" Background="#0C1421"/>
     </Grid>
    </Border>
   </Grid></ScrollViewer>
  </Grid>

  <!-- Нижняя панель действий -->
  <WrapPanel Grid.Row="3" Orientation="Horizontal" Margin="0,18,0,0">
   <Button x:Name="StartButton" Content="{DynamicResource s_eba9b1e58c65}" Background="#1CA989" Foreground="#041C16" FontWeight="Bold" Width="135" Click="Start_Click"/>
   <Button x:Name="ApplyButton" Content="{DynamicResource s_f2c7cb993eaa}" Width="145" IsEnabled="False" Click="Apply_Click"/>
   <Button x:Name="StopButton" Content="{DynamicResource s_6f5a1e2744e1}" Width="110" IsEnabled="False" Click="Stop_Click"/>
   <Button x:Name="PrivacyMuteButton" Content="🔒 MUTE" Width="95" ToolTip="{DynamicResource s_148698ac08ca}" Click="PrivacyMute_Click"/>
   <Button x:Name="StreamHudButton" Content="📊 STREAM HUD" Click="ToggleHud_Click" Padding="12,8" Margin="0,0,6,0" Background="#152435" Foreground="#70E5C3" ToolTip="{DynamicResource s_d28f94231218}"/>
   <Button x:Name="TestButton" Content="{DynamicResource s_184b7efc89cb}" Click="Test_Click"/>
    <Button Content="USB · 60 FPS" Click="Usb60_Click" Visibility="{Binding Visibility, ElementName=ProPresetBar}"/>
    <Button Content="{DynamicResource s_e9e20d7fdbd5}" Click="LatencyTest_Click" Visibility="{Binding Visibility, ElementName=ProPresetBar}"/>
   <Button Content="{DynamicResource s_325cf7ab9057}" Click="Obs_Click"/>
  </WrapPanel>

  <!-- Модальное окно сохранения пресета -->
  <Grid x:Name="SavePresetModal" Grid.Row="0" Grid.RowSpan="4" Margin="-24" Background="#D8050B14" Visibility="Collapsed" Panel.ZIndex="1000">
   <Border Width="450" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#0C1524" BorderBrush="#00d2ff" BorderThickness="1.5" CornerRadius="12" Padding="22">
    <StackPanel>
     <TextBlock Text="{DynamicResource s_9de4ad98b5c7}" FontSize="16" FontWeight="Bold" Foreground="#E7F0FF" Margin="0,0,0,8"/>
     <TextBlock Text="{DynamicResource s_9f037ff29808}" FontSize="11.5" Foreground="#8498B4" TextWrapping="Wrap" Margin="0,0,0,16"/>
     <TextBlock Text="{DynamicResource s_47a1439ae5d2}" FontSize="12" FontWeight="SemiBold" Foreground="#70E5C3" Margin="0,0,0,6"/>
     <TextBox x:Name="PresetNameInput" Text="{DynamicResource s_c2c74c8a1db7}" Height="34" VerticalContentAlignment="Center" Padding="10,4" Background="#16263B" Foreground="#E7F0FF" BorderBrush="#2D4665" FontSize="13" Margin="0,0,0,18" KeyDown="PresetNameInput_KeyDown"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="{DynamicResource s_8fbe9b75cbdf}" Click="CancelSavePreset_Click" Padding="14,6" Margin="0,0,8,0" Background="#1B2F44" Foreground="#8498B4" FontSize="12"/>
      <Button Content="{DynamicResource s_5ee521f44de9}" Click="ConfirmSavePreset_Click" Padding="14,6" Background="#163A36" Foreground="#70E5C3" FontWeight="Bold" FontSize="12"/>
     </StackPanel>
    </StackPanel>
   </Border>
  </Grid>
 </Grid>
</Window>
