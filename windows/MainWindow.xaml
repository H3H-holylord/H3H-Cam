<Window x:Class="S8Cam.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="H3H Cam 4.0.7" Icon="app.ico" Width="1180" Height="900" MinWidth="1000" MinHeight="680"
 Background="#090F1A" Foreground="#E7F0FF" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True"
 WindowStartupLocation="CenterScreen">
 <Grid Margin="24">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <!-- Заголовок -->
  <Grid Margin="0,0,0,14">
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <Image Source="app.png" Width="42" Height="42" Margin="0,0,14,0" VerticalAlignment="Center"/>
    <StackPanel VerticalAlignment="Center">
     <TextBlock Text="H3H CAM" FontSize="32" FontWeight="Bold"/>
     <TextBlock Text="КАМЕРА ТЕЛЕФОНА · ВАША СТУДИЯ НА КОМПЬЮТЕРЕ" Foreground="#42D8B2" FontSize="11" Margin="2,2,0,0"/>
    </StackPanel>
   </StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
    <Button x:Name="ModeToggleButton" Content="⚙️ Pro Режим" Click="ModeToggle_Click" Padding="12,6" Margin="0,0,10,0" Background="#162D42" Foreground="#00d2ff" FontWeight="SemiBold" FontSize="12" ToolTip="Переключение между простым базовым интерфейсом и расширенными Pro-настройками"/>
    <Border Background="#152C2B" CornerRadius="16" Padding="16,8">
     <TextBlock x:Name="ConnectionLabel" Text="●  Готов к подключению" Foreground="#70E5C3" FontWeight="SemiBold"/>
    </Border>
   </StackPanel>
  </Grid>

  <!-- Панель быстрых профилей качества в 1 клик -->
  <Border x:Name="ProPresetBar" Grid.Row="1" Margin="0,0,0,14" Background="#0C1524" CornerRadius="10" Padding="12,7">
   <Grid>
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="Auto"/>
     <ColumnDefinition Width="*"/>
     <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <TextBlock Text="ПРЕСЕТЫ:" FontSize="11" FontWeight="Bold" Foreground="#8498B4" VerticalAlignment="Center" Margin="0,0,10,0"/>
    <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <Button x:Name="PresetStreamingBtn" Content="🎮 Стриминг (1080p60 Spout2)" Click="PresetStreaming_Click" Padding="8,5" Margin="0,2,6,2" Background="#162D42" Foreground="#00d2ff" FontSize="11.5" ToolTip="1080p 60 FPS, HEVC, 18 Mbps, Spout2 ВКЛ, MPEG-TS ВЫКЛ, авто-фрейминг"/>
     <Button x:Name="PresetConferenceBtn" Content="💼 Конференции (720p30 Bokeh)" Click="PresetConference_Click" Padding="8,5" Margin="0,2,6,2" Background="#162D42" Foreground="#70E5C3" FontSize="11.5" ToolTip="720p 30 FPS, AVC, 6 Mbps, Виртуальная камера ВКЛ, размытие фона Боке"/>
     <Button x:Name="PresetProBtn" Content="🎬 Pro Качество (1440p30 Spout2)" Click="PresetPro_Click" Padding="8,5" Margin="0,2,6,2" Background="#162D42" Foreground="#FFD700" FontSize="11.5" ToolTip="1440p 2K 30 FPS, HEVC, 25 Mbps, максимальная детализация, Spout2"/>
     <Button x:Name="PresetEcoBtn" Content="🍃 Эко-режим (720p30 Saving)" Click="PresetEco_Click" Padding="8,5" Margin="0,2,8,2" Background="#162D42" Foreground="#A8FFB2" FontSize="11.5" ToolTip="720p 30 FPS, AVC, 4 Mbps, энергосбережение 30 FPS HAL1, минимальный нагрев"/>

     <!-- Разделитель -->
     <Border Width="1" Height="22" Background="#1F364D" Margin="2,2,10,2" VerticalAlignment="Center"/>

     <!-- Пользовательские пресеты -->
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,2">
      <ComboBox x:Name="CustomPresetsCombo" MinWidth="140" MaxWidth="210" Height="27" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11.5" SelectionChanged="CustomPresetsCombo_SelectionChanged" ToolTip="Выберите сохранённый пользовательский пресет для мгновенного применения"/>
      <Button x:Name="SavePresetButton" Content="💾 Сохранить" Click="SavePreset_Click" Padding="8,4" Margin="0,0,4,0" Background="#163A36" Foreground="#70E5C3" FontSize="11.5" ToolTip="Сохранить текущую конфигурацию камеры как пользовательский пресет"/>
      <Button x:Name="DeletePresetButton" Content="🗑️" Click="DeletePreset_Click" Padding="7,4" Margin="0,0,4,0" Background="#2B1822" Foreground="#FF6B6B" FontSize="11.5" ToolTip="Удалить выбранный пользовательский пресет"/>
     </StackPanel>
    </WrapPanel>
    <Button Grid.Column="2" Content="Настроить OBS…" Click="OptimizeObs_Click" Padding="10,5" Background="#1B2F44" Foreground="#00e5ff" FontSize="11.5" ToolTip="Инструкция по подключению OBS без изменения ваших сцен"/>
   </Grid>
  </Border>

  <!-- Основная рабочая область: Слева Вкладки настроек, Справа Превью и Телеметрия -->
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="1.1*"/>
    <ColumnDefinition Width="18"/>
    <ColumnDefinition Width="*"/>
   </Grid.ColumnDefinitions>

   <!-- Левая колонка: Базовый режим (BasicPanel) или Pro режим (SettingsPanel) -->
   <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="14">
    <Grid>
     <!-- 1. Базовый режим (Basic Mode) -->
     <ScrollViewer x:Name="BasicPanel" VerticalScrollBarVisibility="Auto" Padding="4,4,8,4" Visibility="Collapsed">
      <StackPanel>
       <!-- Карточка устройства -->
       <Border Background="#0C1524" CornerRadius="10" Padding="14" Margin="0,0,0,12" BorderBrush="#1C2E42" BorderThickness="1">
        <StackPanel>
         <DockPanel Margin="0,0,0,6">
          <TextBlock Text="📱 УСТРОЙСТВО" FontSize="12" FontWeight="Bold" Foreground="#42D8B2" VerticalAlignment="Center"/>
          <TextBlock x:Name="BasicTransportBadge" Text="НЕ ПОДКЛЮЧЕНО" Foreground="#70E5C3" Background="#162D42" Padding="6,2" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
         </DockPanel>
         <TextBlock x:Name="BasicDeviceNameText" Text="Подключите телефон" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
         <TextBlock x:Name="BasicBatteryText" Text="🔋 Батарея: ожидание подключения" Foreground="#BFCDE0" FontSize="12.5" Margin="0,0,0,2"/>
         <TextBlock x:Name="BasicTransportText" Text="Выберите подключение и нажмите «Найти телефон»." Foreground="#8498B4" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
       </Border>

       <TextBlock Text="01 / ПОДКЛЮЧЕНИЕ" FontSize="11" FontWeight="SemiBold" Foreground="#42D8B2" Margin="0,4,0,6"/>
       <ComboBox x:Name="BasicTransportChoice" SelectedIndex="{Binding SelectedIndex, ElementName=Transport, Mode=TwoWay}" Margin="0,4,0,8">
        <ComboBoxItem Content="Авто · USB Direct / ADB / Wi-Fi"/>
        <ComboBoxItem Content="Wi-Fi · через локальную сеть"/>
        <ComboBoxItem Content="USB · через ADB"/>
        <ComboBoxItem Content="USB Direct · нужен WinUSB"/>
       </ComboBox>
       <TextBox Text="{Binding Text, ElementName=PhoneIp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" ToolTip="IP-адрес телефона для Wi-Fi">
        <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
         <Setter Property="Visibility" Value="Collapsed"/>
         <Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=Transport}" Value="1"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
        </Style></TextBox.Style>
       </TextBox>
       <Button Content="Найти телефон" Click="Scan_Click" IsEnabled="{Binding IsEnabled, ElementName=ScanButton}" HorizontalAlignment="Stretch" Margin="0,0,0,6"/>
       <TextBlock Text="{Binding Text, ElementName=DeviceHint}" Foreground="#8498B4" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,16"/>
       <!-- Камера -->
       <TextBlock Text="02 / КАМЕРА" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
       <ComboBox x:Name="BasicCameraChoice" DisplayMemberPath="Label" SelectedValuePath="Key" SelectionChanged="BasicCameraChoice_Changed" Margin="0,0,0,8"/>


       <!-- Ориентация кадра -->
       <TextBlock Text="Ориентация кадра" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
       <UniformGrid Columns="2" Margin="0,0,0,12">
        <RadioButton x:Name="BasicOrientation169" Content="🖥️ 16:9 Горизонт" GroupName="BasicOrientation" Checked="BasicOrientation_Checked" FontSize="12.5" Padding="4,0,0,0" VerticalContentAlignment="Center"/>
        <RadioButton x:Name="BasicOrientation916" Content="📱 9:16 Shorts" GroupName="BasicOrientation" Checked="BasicOrientation_Checked" FontSize="12.5" Padding="4,0,0,0" VerticalContentAlignment="Center"/>
       </UniformGrid>

       <!-- Пресет качества -->
       <TextBlock Text="Пресет качества" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
       <UniformGrid Columns="2" Margin="0,0,0,12">
        <Button Content="🎮 Стриминг (1080p60)" Click="PresetStreaming_Click" Padding="8,8" Margin="0,0,4,4" Background="#162D42" Foreground="#00d2ff" FontSize="11.5"/>
        <Button Content="💼 Конференции (720p)" Click="PresetConference_Click" Padding="8,8" Margin="4,0,0,4" Background="#162D42" Foreground="#70E5C3" FontSize="11.5"/>
        <Button Content="🎬 Pro Качество (1440p)" Click="PresetPro_Click" Padding="8,8" Margin="0,4,4,0" Background="#162D42" Foreground="#FFD700" FontSize="11.5"/>
        <Button Content="🍃 Эко-режим (30 FPS)" Click="PresetEco_Click" Padding="8,8" Margin="4,4,0,0" Background="#162D42" Foreground="#A8FFB2" FontSize="11.5"/>
       </UniformGrid>

       <!-- Быстрые переключатели -->
       <TextBlock Text="03 / ВЫХОДЫ И ПРЕДПРОСМОТР" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
       <CheckBox x:Name="BasicPreviewCheck" Content="Показывать предпросмотр" IsChecked="{Binding IsChecked, ElementName=Preview, Mode=TwoWay}" Margin="0,0,0,8"/>
       <CheckBox Content="Гасить экран телефона (ADB)" IsChecked="{Binding IsChecked, ElementName=ScreenOff, Mode=TwoWay}" Margin="0,0,0,8"/>
       <CheckBox x:Name="BasicVirtualCamCheck" Content="Виртуальная камера (Zoom / Discord)" Click="BasicVirtualCam_Click" Margin="0,0,0,8"/>
       <CheckBox x:Name="BasicSpoutCheck" Content="Spout2 для OBS Studio" Click="BasicSpout_Click" Margin="0,0,0,8"/>
       <CheckBox x:Name="BasicFaceTrackingCheck" Content="Авто-слежение за лицом (Center Stage)" Click="BasicFaceTracking_Click" Margin="0,0,0,8"/>
       <CheckBox x:Name="BasicStabilizationCheck" Content="🎯 Стабилизация от тряски (OIS / EIS)" Click="BasicStabilization_Click" Margin="0,0,0,4"/>
       <CheckBox x:Name="BasicSuperSteadyCheck" Content="🚀 Усиленный Super Steady (анти-вибрация мыши)" Click="BasicSuperSteady_Click" Margin="20,0,0,14" ToolTip="Анти-вибрационный буфер сенсора: поглощает сильную раскачку стола и резкие движения мыши"/>

       <!-- Большая кнопка Старт -->
       <Button x:Name="BasicStartButton" Content="▶  НАЧАТЬ ТРАНСЛЯЦИЮ" Height="50" Background="#1CA989" Foreground="#041C16" FontWeight="Bold" FontSize="16" Click="BasicStart_Click" Margin="0,0,0,10"/>

       <!-- Переход в Pro режим -->
       <Button Content="⚙️ Расширенные настройки (Pro Mode) →" Click="ModeToggle_Click" Background="Transparent" Foreground="#42D8B2" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center" FontSize="12" Margin="0,6,0,6"/>
      </StackPanel>
     </ScrollViewer>

     <!-- 2. Расширенный режим (Pro Mode) -->
     <TabControl x:Name="SettingsPanel">

     <!-- Вкладка 1: 🔌 Связь -->
     <TabItem Header="🔌 Связь">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,12,8,0">
       <StackPanel>
        <TextBlock Text="Подключение смартфона" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>

        <TextBlock Text="Режим подключения"/>
        <ComboBox x:Name="Transport">
         <ComboBoxItem Content="Авто · активный USB Direct, ADB, Wi-Fi"/>
         <ComboBoxItem Content="Wi-Fi · RTP"/>
         <ComboBoxItem Content="USB · кабель без Wi-Fi"/>
         <ComboBoxItem Content="USB Direct · без ADB и режима разработчика"/>
        </ComboBox>

        <TextBlock Text="Телефон"/>
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <ComboBox x:Name="DeviceChoice" DisplayMemberPath="Label" SelectedValuePath="Key" Margin="0,4,8,10"/>
         <Button Grid.Column="1" x:Name="ScanButton" Content="НАЙТИ" Click="Scan_Click" Margin="0,4,0,10" Padding="16,8"/>
        </Grid>
        <TextBlock x:Name="DeviceHint" Text="USB Direct не требует режима разработчика. При первом подключении Windows может потребоваться драйвер WinUSB для H3H Cam." Foreground="#8498B4" FontSize="11.5" TextWrapping="Wrap" Margin="0,-4,4,10"/>

        <CheckBox x:Name="ScreenOff" Content="Гасить экран телефона после появления видео" Margin="0,0,0,6"/>

        <DockPanel Margin="0,0,0,4">
         <Button x:Name="InstallVirtualCamButton" Content="📥 Установить DirectShow VCam" Click="InstallVirtualCam_Click" DockPanel.Dock="Right" Padding="10,4" Margin="6,0,0,0" FontSize="11" Background="#203A4E" Foreground="#70E5C3" Visibility="Collapsed"/>
         <CheckBox x:Name="VirtualCamera" Content="Виртуальная камера для Discord / Zoom / Telegram" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock x:Name="VirtualCamStatusText" Text="● Проверка статуса виртуальной камеры..." Foreground="#8498B4" FontSize="11" Margin="24,-2,0,8"/>

        <CheckBox x:Name="Preview" Content="Показывать предпросмотр · можно переключать во время стрима" Checked="Preview_Changed" Unchecked="Preview_Changed" Margin="0,0,0,10"/>

        <TextBlock Text="Сетевые адреса (Wi-Fi / LAN)" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,6"/>
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel Margin="0,0,4,0"><TextBlock Text="Адрес телефона · IP:порт"/><TextBox x:Name="PhoneIp"/></StackPanel>
         <StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBlock Text="Адрес компьютера"/><TextBox x:Name="PcIp"/></StackPanel>
        </Grid>

        <DockPanel Margin="0,4,0,8">
         <Button x:Name="ShowQrButton" Content="📱 QR-код / Wi-Fi автопоиск" Click="ShowQr_Click" DockPanel.Dock="Right" Padding="12,5" FontSize="11" Margin="6,0,0,0" Background="#1B2F44" Foreground="#70E5C3"/>
         <CheckBox x:Name="AutoPcIp" Content="Автоматически выбирать адрес ПК" Checked="AutoPcIp_Changed" Unchecked="AutoPcIp_Changed" VerticalAlignment="Center"/>
        </DockPanel>

        <TextBlock Text="Порты передачи данных" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,6"/>
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel Margin="0,0,3,0"><TextBlock Text="RTP порт"/><TextBox x:Name="RtpPort"/></StackPanel>
         <StackPanel Grid.Column="1" Margin="3,0,3,0"><TextBlock Text="USB порт"/><TextBox x:Name="UsbPort"/></StackPanel>
         <StackPanel Grid.Column="2" Margin="3,0,0,0"><TextBlock Text="OBS порт"/><TextBox x:Name="ObsPort"/></StackPanel>
        </Grid>

        <TextBlock Text="Автоматизация подключения" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,6"/>
        <CheckBox x:Name="AutoReconnect" Content="🔄 Авто-переподключение USB при выпадении кабеля (Watchdog)" ToolTip="Автоматически восстанавливает поток без перезапуска приложения при случайном отключении/подключении USB" Margin="0,0,0,6"/>
        <CheckBox x:Name="AutoStartOnUsb" Content="⚡ Автостарт при подключении USB (Plug &amp; Play)" Margin="0,0,0,6"/>
        <CheckBox x:Name="AutoStart" Content="🚀 Автоматически запускать поток при открытии клиента" Margin="0,0,0,6"/>
       </StackPanel>
      </ScrollViewer>
     </TabItem>

     <!-- Вкладка 2: 🎥 Камера -->
     <TabItem Header="🎥 Камера">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,12,8,0">
       <StackPanel>
        <TextBlock Text="Сенсор и видеопоток" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>

        <TextBlock Text="Модуль камеры"/>
        <ComboBox x:Name="CameraChoice" DisplayMemberPath="Label" SelectedValuePath="Key" SelectionChanged="CameraChoice_Changed"/>
        <TextBlock x:Name="CameraHint" Text="После поиска здесь появятся все камеры, которые Android открыл через Camera2." Foreground="#8498B4" FontSize="11.5" TextWrapping="Wrap" Margin="0,-2,4,10"/>

        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel Margin="0,0,4,0"><TextBlock Text="Разрешение"/><ComboBox x:Name="ResolutionChoice" DisplayMemberPath="Label" SelectionChanged="ResolutionChoice_Changed"/></StackPanel>
         <StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBlock Text="Частота кадров"/><ComboBox x:Name="Fps"/></StackPanel>
        </Grid>

        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel Margin="0,0,4,0"><TextBlock Text="Битрейт · Mbps"/><TextBox x:Name="Bitrate"/></StackPanel>
         <StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBlock Text="Кодек видео"/><ComboBox x:Name="CodecChoice">
          <ComboBoxItem Content="H.264 / AVC · универсальный"/>
          <ComboBoxItem Content="H.265 / HEVC · максимальное качество"/>
         </ComboBox></StackPanel>
        </Grid>

        <Grid Margin="0,4,0,6">
         <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel Margin="0,0,4,0"><TextBlock Text="Цифровой зум"/><ComboBox x:Name="ZoomChoice">
          <ComboBoxItem Content="1.0x · без приближения"/>
          <ComboBoxItem Content="1.2x"/>
          <ComboBoxItem Content="1.5x"/>
          <ComboBoxItem Content="2.0x"/>
          <ComboBoxItem Content="3.0x"/>
         </ComboBox></StackPanel>
         <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,18,0,0">
          <CheckBox x:Name="Torch" Content="🔦 Подсветка · фонарик"/>
         </StackPanel>
        </Grid>

        <WrapPanel Margin="0,2,0,4">
         <CheckBox x:Name="LowLatency" Content="⚡ Минимальная задержка" Margin="0,0,16,4"/>
         <CheckBox x:Name="ObsOutput" Content="📡 Доп. MPEG-TS выход для OBS" Margin="0,0,16,4"/>
         <CheckBox x:Name="SpoutOutput" Content="Spout2 · выход в OBS" ToolTip="Передача текстуры Direct3D 11 в OBS. Декодирование и эффекты используют ресурсы компьютера." Margin="0,0,0,4"/>
        </WrapPanel>
        <Button Content="🧹 Оптимизировать сцены OBS для Spout2" Click="OptimizeObs_Click" HorizontalAlignment="Left" Margin="0,0,0,10" Padding="10,4" Background="#142638" Foreground="#00e5ff" FontSize="11" ToolTip="Отключает устаревший источник 5001 в сценах OBS и гарантирует работу Spout2"/>

        <!-- 💎 AI Super Resolution 4K -->
        <Border Background="#0C1524" CornerRadius="8" Padding="10" Margin="0,0,0,10">
         <StackPanel>
          <DockPanel Margin="0,0,0,6">
           <CheckBox x:Name="SuperResolution4KCheck" Content="💎 AI Super Resolution 4K (3840×2160 @ 60 FPS)" FontWeight="SemiBold" Foreground="#42D8B2" VerticalAlignment="Center" ToolTip="Аппаратный супер-резолюшн на RTX 4070 Ti: телефон шлет 1080p/1440p без перегрева, а в Spout2 и OBS уходит ультрачеткий честный 4K UHD поток"/>
           <TextBlock Text="RTX 4070 Ti" Foreground="#00FFB2" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </DockPanel>
          <DockPanel Margin="0,2,0,2">
           <TextBlock Text="Контрастно-адаптивная резкость (RCAS):" FontSize="11.5" Foreground="#8498B4" VerticalAlignment="Center"/>
           <TextBlock x:Name="SuperResolutionSharpnessText" Text="20%" Foreground="#42D8B2" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
          </DockPanel>
          <Slider x:Name="SuperResolutionSharpnessSlider" Minimum="0.0" Maximum="0.50" Value="0.20" SmallChange="0.02" LargeChange="0.10" ValueChanged="SuperResolutionSharpnessSlider_ValueChanged"/>
         </StackPanel>
        </Border>

        <TextBlock Text="Экспозиция и профессиональный фокус" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,8"/>

        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel Margin="0,0,4,0"><TextBlock Text="Режим фокуса"/><ComboBox x:Name="FocusMode">
          <ComboBoxItem Content="Непрерывный"/><ComboBoxItem Content="Авто · один раз"/><ComboBoxItem Content="Бесконечность"/><ComboBoxItem Content="Ручной"/>
         </ComboBox></StackPanel>
         <StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBlock Text="Ручной фокус · диоптрии"/><TextBox x:Name="FocusDistance"/></StackPanel>
        </Grid>

        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel Margin="0,0,4,0"><TextBlock Text="Выдержка (Shutter Speed)"/><ComboBox x:Name="ShutterChoice">
          <ComboBoxItem Content="Авто (AE)"/>
          <ComboBoxItem Content="1/25 с · 40 ms"/>
          <ComboBoxItem Content="1/30 с · 33.3 ms"/>
          <ComboBoxItem Content="1/50 с · 20 ms (50Hz RU/EU)"/>
          <ComboBoxItem Content="1/60 с · 16.7 ms (60Hz US)"/>
          <ComboBoxItem Content="1/100 с · 10 ms (студия 50Hz)"/>
          <ComboBoxItem Content="1/120 с · 8.3 ms (студия 60Hz)"/>
          <ComboBoxItem Content="1/200 с · 5 ms"/>
          <ComboBoxItem Content="1/250 с · 4 ms"/>
          <ComboBoxItem Content="1/500 с · 2 ms"/>
          <ComboBoxItem Content="1/1000 с · 1 ms"/>
         </ComboBox></StackPanel>
