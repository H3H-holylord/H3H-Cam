           <CheckBox x:Name="ObsEcoModeCheck" Content="🍃 Эко-пауза OBS: снижать поток до 4 Мбит/с, когда сцена не в эфире" Margin="0,0,0,8"
                     ToolTip="Бережёт аккумулятор и охлаждает смартфон, пока в OBS включена другая сцена или заставка; при возврате на сцену мгновенно возвращает полный битрейт"/>

           <TextBlock Text="Имя аудиовхода в OBS для авто-синхронизации Lip-Sync:" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
           <Grid Margin="0,3,0,2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="ObsAudioInputNameBox" Margin="0,0,6,0" ToolTip="Например: Mic/Aux или Микрофон телефона"/>
            <Button Grid.Column="1" Content="⚡ Синхр. Lip-Sync" Click="SyncObsAudio_Click" Padding="11,6" Margin="0" FontSize="11.5"
                    Background="{DynamicResource AccentSoftBgBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" Foreground="{DynamicResource AccentPrimaryBrush}"/>
           </Grid>
          </StackPanel>
         </Border>
        </StackPanel>
       </ScrollViewer>
      </TabItem>

     </TabControl>
    </Grid>
   </Border>

   <!-- ПРАВАЯ КОЛОНКА: РЕЖИССЁРСКИЙ МОНИТОР 16:9, VU-МЕТР, FOCUS PULL, ТЕЛЕМЕТРИЯ И ЖУРНАЛ -->
   <ScrollViewer x:Name="RightColumnScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
     </Grid.RowDefinitions>

     <!-- КАРТОЧКА 1: РЕЖИССЁРСКИЙ МОНИТОР И ОПЕРАТОРСКИЙ ПУЛЬТ -->
     <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,12">
      <StackPanel>

       <!-- Шапка монитора: Статус + Индикатор ON AIR TALLY + Частота/Битрейт -->
       <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="*"/>
         <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
         <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{DynamicResource s_3baa8d8e55e2}" FontSize="17" FontWeight="Bold"/>
          <!-- Индикатор Tally (ON AIR) -->
          <Border x:Name="TallyBadgeBorder" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
           <TextBlock x:Name="TallyBadgeText" Text="● STANDBY" FontFamily="Consolas" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
          </Border>
         </StackPanel>
         <TextBlock x:Name="StateText" Text="{DynamicResource s_3028fa0907c0}" Foreground="{DynamicResource AccentPrimaryBrush}" FontSize="12.5" FontWeight="SemiBold" Margin="0,3,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Компактные приборные счётчики битрейта и FPS -->
        <StackPanel x:Name="MonitorMetricsStrip" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
         <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="0,0,6,0">
          <StackPanel>
           <TextBlock Text="{DynamicResource s_1f1eaea3b57b}" Foreground="{DynamicResource TextMutedBrush}" FontSize="9.5"/>
           <TextBlock x:Name="RateText" Text="0.00 Mbps" FontFamily="Consolas" FontSize="16" FontWeight="Bold"/>
          </StackPanel>
         </Border>
         <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="10,5">
          <StackPanel>
           <TextBlock Text="{DynamicResource s_c14ac2838145}" Foreground="{DynamicResource TextMutedBrush}" FontSize="9.5"/>
           <TextBlock x:Name="FpsText" Text="— / 30 fps" FontFamily="Consolas" FontSize="16" FontWeight="Bold"/>
          </StackPanel>
         </Border>
        </StackPanel>
       </Grid>

       <TextBlock x:Name="TechnicalText" Text="{DynamicResource s_c1daaf23a1b4}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" LineHeight="18" TextWrapping="Wrap" Margin="0,0,0,8"/>

       <!-- КРУПНЫЙ РЕЖИССЁРСКИЙ ВИДОИСКАТЕЛЬ 16:9 -->
       <Border x:Name="PreviewContainer" Background="{DynamicResource MonitorWellBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="2" CornerRadius="10" MinHeight="295" Margin="0,0,0,8" ClipToBounds="True" MouseWheel="VideoPreview_MouseWheel">
        <Grid MouseWheel="VideoPreview_MouseWheel">
         <!-- Кадр видеопотока -->
         <Image x:Name="LivePreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality" MouseDown="VideoPreview_MouseDown" MouseWheel="VideoPreview_MouseWheel" Cursor="Cross"/>

         <!-- Заглушка до запуска -->
         <Grid x:Name="PreviewPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
          <StackPanel HorizontalAlignment="Center">
           <TextBlock Text="🎬" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,6" Opacity="0.65"/>
           <TextBlock Text="{DynamicResource s_4eb00f95c854}" Foreground="#B8B4AC" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
           <TextBlock Text="{DynamicResource s_fa1c7d726b30}" Foreground="#F59E0B" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center"/>
          </StackPanel>
         </Grid>

         <!-- Слои фокуса, сетки и автокадра -->
         <Canvas x:Name="FocusCanvas" ClipToBounds="True" IsHitTestVisible="False"/>
         <Canvas x:Name="GridCanvas" ClipToBounds="True" IsHitTestVisible="False" Visibility="Collapsed" SizeChanged="GridCanvas_SizeChanged"/>
         <Canvas x:Name="FaceCanvas" ClipToBounds="True" IsHitTestVisible="False"/>

         <!-- Верхние студийные HUD-бейджи поверх монитора -->
         <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0" IsHitTestVisible="False">
          <Border x:Name="ResolutionBadgeBorder" Visibility="Collapsed" Background="#CC121110" BorderBrush="#44FFFFFF" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="0,0,6,0">
           <TextBlock x:Name="PreviewResolutionBadge" Text="1920×1080" FontFamily="Consolas" Foreground="#F4F1EA" FontSize="10.5" FontWeight="Bold"/>
          </Border>
          <Border x:Name="LutBadgeBorder" Visibility="Collapsed" Background="#CCF59E0B" CornerRadius="5" Padding="7,2" Margin="0,0,6,0">
           <TextBlock x:Name="LutBadgeText" Text="LUT: KODAK 2383" FontFamily="Consolas" Foreground="#141312" FontSize="10" FontWeight="Bold"/>
          </Border>
          <Border x:Name="RecBadgeBorder" Visibility="Collapsed" Background="#E5DC2626" CornerRadius="5" Padding="7,2">
           <TextBlock x:Name="RecBadgeText" Text="● REC 00:00" FontFamily="Consolas" Foreground="White" FontSize="10.5" FontWeight="Bold"/>
          </Border>
         </StackPanel>

         <!-- ЖИВОЙ ВИДЕОСКОП В ПРАВОМ НИЖНЕМ УГЛУ (Luma Waveform / RGB Parade / Histogram) -->
         <Border x:Name="ScopeBorder" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,28"
                 Background="#D810100F" BorderBrush="#55FFFFFF" BorderThickness="1" CornerRadius="6" Padding="3" IsHitTestVisible="False">
          <StackPanel>
           <TextBlock x:Name="ScopeTitleText" Text="LUMA WAVEFORM · IRE" FontFamily="Consolas" FontSize="8.5" FontWeight="Bold" Foreground="#C8C2B8" Margin="3,0,0,2"/>
           <Image x:Name="ScopeImage" Width="204" Height="88" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
          </StackPanel>
         </Border>

         <!-- Индикатор зоны калибровки ББ -->
         <Border x:Name="WbTargetBox" Width="120" Height="90" BorderBrush="#84CC16" BorderThickness="1.5" CornerRadius="6" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False">
          <TextBlock x:Name="WbTargetBoxText" Text="{DynamicResource s_85e2d3a5748f}" Foreground="#84CC16" FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2" Background="#D9121110" Padding="4,1"/>
         </Border>

         <!-- Вспышка затвора -->
         <Border x:Name="CameraFlashOverlay" Background="White" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

         <!-- Нижняя подсказка монитора -->
         <Border VerticalAlignment="Bottom" Background="#AD100F0E" Padding="8,3" IsHitTestVisible="False">
          <TextBlock Text="{DynamicResource s_1469f5b2a80b}" Foreground="#D8D3C8" FontSize="10" HorizontalAlignment="Center"/>
         </Border>
        </Grid>
       </Border>

       <!-- СТУДИЙНЫЙ VU-МЕТР МИКРОФОНА И БЫСТРАЯ ШТОРКА -->
       <Border x:Name="AudioMeterBar" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="0,0,0,8">
        <Grid>
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="68"/>
          <ColumnDefinition Width="Auto"/>
         </Grid.ColumnDefinitions>
         <Button x:Name="QuickMicMuteButton" Content="🎙️ MIC OFF" Click="QuickMicToggle_Click" Padding="9,4" Margin="0,0,8,0" FontSize="11" FontWeight="SemiBold"
                 ToolTip="Быстрое включение / отключение микрофона смартфона"/>
         <Border x:Name="VuMeterTrack" Grid.Column="1" Height="10" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" VerticalAlignment="Center" ClipToBounds="True">
          <Border x:Name="VuMeterFill" HorizontalAlignment="Left" Width="0" Background="{DynamicResource AccentLiveBrush}" CornerRadius="3"/>
         </Border>
         <TextBlock x:Name="VuDbText" Grid.Column="2" Text="ВЫКЛ" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0,8,0"/>
         <Button x:Name="QuickSlateButton" Grid.Column="3" Content="🔒 ШТОРКА" Click="PrivacyMute_Click" Padding="9,4" Margin="0" FontSize="11" FontWeight="SemiBold"
                 ToolTip="Умная шторка приватности: закрыть видео заставкой и заглушить микрофон"/>
        </Grid>
       </Border>

       <!-- ПУЛЬТ КИНЕМАТОГРАФИЧЕСКОГО ПЕРЕВОДА ФОКУСА (FOCUS PULL A ↔ B) -->
       <Border x:Name="FocusPullBar" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="0,0,0,8">
        <Grid>
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
         </Grid.ColumnDefinitions>
         <Button x:Name="SetFocusAButton" Content="A · 0.35" Click="SetFocusA_Click" Padding="9,4" Margin="0,0,6,0" FontFamily="Consolas" FontSize="11"
                 ToolTip="Запомнить текущую дистанцию фокуса в точку A (или переключиться к A)"/>
         <Button x:Name="RunFocusPullButton" Grid.Column="1" Content="⇄ ПЛАВНЫЙ ФОКУС A ↔ B" Click="RunFocusPull_Click" Padding="10,4" Margin="0,0,6,0" FontSize="11.5" FontWeight="SemiBold"
                 Background="{DynamicResource AccentSoftBgBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" Foreground="{DynamicResource AccentPrimaryBrush}"
                 ToolTip="Плавно перевести фокус объектива между точками A и B с кинематографическим сглаживанием"/>
         <Button x:Name="SetFocusBButton" Grid.Column="2" Content="B · 2.50" Click="SetFocusB_Click" Padding="9,4" Margin="0,0,6,0" FontFamily="Consolas" FontSize="11"
                 ToolTip="Запомнить текущую дистанцию фокуса в точку B"/>
         <ComboBox x:Name="FocusPullSpeedChoice" Grid.Column="3" Width="96" Margin="0" Padding="6,3" FontSize="11" SelectionChanged="FocusPullSpeedChoice_Changed" ToolTip="Длительность плавного перевода фокуса">
          <ComboBoxItem Content="0.4 с"/>
          <ComboBoxItem Content="0.8 с"/>
          <ComboBoxItem Content="1.5 с"/>
         </ComboBox>
        </Grid>
       </Border>

       <!-- ОПЕРАТОРСКИЕ ИНСТРУМЕНТЫ МОНИТОРА (Объективы, Экспозиция, Скопы, Запись) -->
       <WrapPanel x:Name="MonitorToolsWrap" Margin="0,0,0,2">
        <Button x:Name="SnapshotButton" Content="{DynamicResource s_3d7e3f5b1a17}" Padding="8,5" FontSize="11" Margin="0,0,4,4" Click="Snapshot_Click" ToolTip="{DynamicResource s_a24cda0bd19d}"/>
        <Button x:Name="RecordButton" Content="{DynamicResource s_70c75c89eb79}" Padding="8,5" FontSize="11" Margin="0,0,6,4" Click="Record_Click"
                Background="{DynamicResource AccentTallySoftBgBrush}" BorderBrush="{DynamicResource AccentTallyBrush}" Foreground="{DynamicResource AccentTallyBrush}" ToolTip="{DynamicResource s_fe554d1c0419}"/>

        <Button x:Name="LensWideButton" Content="0.6x" Padding="8,5" FontSize="11" Margin="0,0,3,4" Click="LensWide_Click" ToolTip="{DynamicResource s_93f7f620cdae}"/>
        <Button x:Name="LensMainButton" Content="1.0x" Padding="8,5" FontSize="11" Margin="0,0,3,4" Click="LensMain_Click" ToolTip="{DynamicResource s_518e154c4dbe}"/>
        <Button x:Name="LensTeleButton" Content="2.0x" Padding="8,5" FontSize="11" Margin="0,0,6,4" Click="LensTele_Click" ToolTip="{DynamicResource s_f2b6d6510258}"/>

        <Button x:Name="GridButton" Content="📐 GRID" Padding="8,5" FontSize="11" Margin="0,0,3,4" Click="Grid_Click" ToolTip="{DynamicResource s_b6b7e8d1276d}"/>
        <Button x:Name="PeakButton" Content="🔍 PEAK" Padding="8,5" FontSize="11" Margin="0,0,3,4" Click="Peak_Click" ToolTip="{DynamicResource s_a5350a30942c}"/>
        <Button x:Name="ZebraButton" Content="🦓 ZEBRA" Padding="8,5" FontSize="11" Margin="0,0,3,4" Click="Zebra_Click" ToolTip="{DynamicResource s_787448f22452}"/>
        <Button x:Name="FalseColorButton" Content="🌈 IRE" Padding="8,5" FontSize="11" Margin="0,0,6,4" Click="FalseColor_Click"
                ToolTip="False Color (шкала экспозиции IRE: розовый ~55 IRE для кожи, красный >=95 IRE пересвет, синий/фиолетовый провал в тенях)"/>

        <ComboBox x:Name="ScopeModeChoice" Width="134" Margin="0,0,6,4" Padding="7,4" FontSize="11" SelectionChanged="ScopeModeChoice_SelectionChanged"
                  ToolTip="Живой студийный видеоскоп поверх монитора">
         <ComboBoxItem Content="📉 Скопы: Выкл"/>
         <ComboBoxItem Content="📈 Waveform"/>
         <ComboBoxItem Content="📊 RGB Parade"/>
         <ComboBoxItem Content="📉 Гистограмма"/>
        </ComboBox>

        <Button x:Name="AutoFramingButton" Content="🤖 CENTER" Padding="8,5" FontSize="11" Margin="0,0,3,4" Click="AutoFraming_Click" ToolTip="{DynamicResource s_a6e3bb46b89d}"/>
        <Button x:Name="FaceTrackingButton" Content="👤 FACE" Padding="8,5" FontSize="11" Margin="0,0,3,4" Click="FaceTracking_Click" ToolTip="{DynamicResource s_4814ff102c60}"/>
        <Button x:Name="FaceOverlayButton" Content="🎯 BOX" Padding="8,5" FontSize="11" Margin="0,0,3,4" Click="FaceOverlay_Click" ToolTip="{DynamicResource s_5b9a76113ad5}"/>
        <Button x:Name="LockAeAwbButton" Content="🔓 AE/AWB" Padding="8,5" FontSize="11" Margin="0,0,3,4" Click="LockAeAwb_Click" ToolTip="{DynamicResource s_ec1de973f6a2}"/>
        <Button x:Name="QuickWbButton" Content="📄 WB" Padding="8,5" FontSize="11" Margin="0,0,3,4" Click="CalibrateWb_Click" ToolTip="{DynamicResource s_8268d14811d3}"/>
        <Button x:Name="PopoutPreviewButton" Content="{DynamicResource s_4c39c8966302}" Padding="8,5" FontSize="11" Margin="0,0,3,4" Click="PopoutPreview_Click" ToolTip="{DynamicResource s_3bff217e3905}"/>
        <Button x:Name="FfplayButton" Content="ffplay" Padding="8,5" FontSize="11" Margin="0,0,0,4" Click="Ffplay_Click" ToolTip="{DynamicResource s_7326dc1bbfb9}"/>
       </WrapPanel>

       <TextBlock x:Name="DetailText" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
      </StackPanel>
     </Border>

     <!-- КАРТОЧКА 2: ПИТАНИЕ И ТЕМПЕРАТУРА СМАРТФОНА -->
     <Border x:Name="PowerTelemetryCard" Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="14" Padding="15" Margin="0,0,0,12">
      <StackPanel>
       <DockPanel>
        <TextBlock Text="{DynamicResource s_ada21f57d547}" FontSize="15.5" FontWeight="SemiBold"/>
        <TextBlock x:Name="PowerSourceText" Text="N/A" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
       </DockPanel>
       <TextBlock x:Name="PowerHeadlineText" Text="N/A  •  N/A" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource AccentLiveBrush}" Margin="0,5,0,2"/>
       <TextBlock x:Name="PowerQuickText" Text="Battery voltage N/A  ·  Current N/A  ·  Power N/A  ·  Temperature N/A" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
       <TextBlock x:Name="PowerWarningText" Text="{DynamicResource s_ac6524c18735}" Foreground="{DynamicResource AccentPrimaryBrush}" FontSize="11.5" Margin="0,4,0,0" TextWrapping="Wrap"/>
       <Border Background="{DynamicResource ConsoleWellBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Margin="0,6,0,0" Padding="2">
        <Canvas x:Name="PowerChart" Height="42" ClipToBounds="True" SizeChanged="PowerChart_SizeChanged" Background="Transparent"/>
       </Border>
       <TextBlock Text="{DynamicResource s_d2901c8fae3f}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,3,0,0"/>
       <Expander Header="{DynamicResource s_bd56e377a50a}" Margin="0,4,0,0">
        <TextBlock x:Name="PowerDetailsText" Text="N/A" FontFamily="Consolas" FontSize="11" LineHeight="16" Margin="0,6,0,0"/>
       </Expander>
      </StackPanel>
     </Border>

     <!-- КАРТОЧКА 3: ЖУРНАЛ СОБЫТИЙ И ДИАГНОСТИКА -->
     <Border x:Name="EventLogCard" MinHeight="165" Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="14" Padding="15">
      <Grid>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <DockPanel Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
         <Button Content="{DynamicResource s_c27caba688b1}" Padding="8,4" Margin="0,0,4,0" Click="CopyDiagnostics_Click" FontSize="10.5" ToolTip="{DynamicResource s_d52a5c964c87}"/>
         <Button Content="{DynamicResource s_4bd70174370f}" Padding="8,4" Margin="0,0,4,0" Click="OpenLogsFolder_Click" FontSize="10.5" ToolTip="{DynamicResource s_4fd11f0e280c}"/>
         <Button Content="{DynamicResource s_a04d10c3daaf}" Padding="8,4" Margin="0,0,4,0" Click="CopyLastErrors_Click" FontSize="10.5" ToolTip="{DynamicResource s_162e2366d4e0}"/>
         <Button Content="📦 ZIP" Padding="8,4" Margin="0,0,4,0" Click="ExportDiagnostics_Click" FontSize="10.5" ToolTip="{DynamicResource s_c956d7a97396}"/>
         <Button Content="{DynamicResource s_70977f4262cf}" Padding="8,4" Margin="0" Click="ClearLog_Click" FontSize="10.5"/>
        </StackPanel>
        <TextBlock Text="{DynamicResource s_97c459a6bb7c}" FontSize="15.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
       </DockPanel>
       <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11.5" BorderThickness="1" Margin="0" Background="{DynamicResource ConsoleWellBrush}"/>
      </Grid>
     </Border>

    </Grid>
   </ScrollViewer>
  </Grid>

  <!-- НИЖНЯЯ ПРИБОРНАЯ ПАНЕЛЬ ДЕЙСТВИЙ -->
  <Border Grid.Row="3" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="12,9" Margin="0,12,0,0">
   <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
    <Button x:Name="StartButton" Content="{DynamicResource s_eba9b1e58c65}"
            Background="{DynamicResource AccentPrimaryBrush}" Foreground="{DynamicResource AccentPrimaryTextBrush}" BorderThickness="0"
            FontWeight="Bold" Width="132" Click="Start_Click"/>
    <Button x:Name="ApplyButton" Content="{DynamicResource s_f2c7cb993eaa}" Width="140" IsEnabled="False" Click="Apply_Click"/>
    <Button x:Name="StopButton" Content="{DynamicResource s_6f5a1e2744e1}" Width="108" IsEnabled="False" Click="Stop_Click"/>
    <Button x:Name="PrivacyMuteButton" Content="🔒 MUTE" Width="102" ToolTip="{DynamicResource s_148698ac08ca}" Click="PrivacyMute_Click"/>

    <WrapPanel x:Name="FooterSecondaryActions" Orientation="Horizontal" VerticalAlignment="Center">
     <Button x:Name="StreamHudButton" Content="📊 STREAM HUD" Click="ToggleHud_Click" Padding="12,8" Margin="0,0,8,0" ToolTip="{DynamicResource s_d28f94231218}"/>
     <Button x:Name="TestButton" Content="{DynamicResource s_184b7efc89cb}" Click="Test_Click"/>
     <Button Content="USB · 60 FPS" Click="Usb60_Click" Visibility="{Binding Visibility, ElementName=ProPresetBar}"/>
     <Button Content="{DynamicResource s_e9e20d7fdbd5}" Click="LatencyTest_Click" Visibility="{Binding Visibility, ElementName=ProPresetBar}"/>
     <Button Content="{DynamicResource s_325cf7ab9057}" Click="Obs_Click" Margin="0"/>
    </WrapPanel>
   </WrapPanel>
  </Border>

  <!-- МОДАЛЬНОЕ ОКНО СОХРАНЕНИЯ ПОЛЬЗОВАТЕЛЬСКОГО ПРЕСЕТА -->
  <Grid x:Name="SavePresetModal" Grid.Row="0" Grid.RowSpan="4" Margin="-18" Background="{DynamicResource ModalBackdropBrush}" Visibility="Collapsed" Panel.ZIndex="1000">
   <Border Width="450" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1.5" CornerRadius="12" Padding="22">
    <StackPanel>
     <TextBlock Text="{DynamicResource s_9de4ad98b5c7}" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
     <TextBlock Text="{DynamicResource s_9f037ff29808}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>
     <TextBlock Text="{DynamicResource s_47a1439ae5d2}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,0,0,6"/>
     <TextBox x:Name="PresetNameInput" Text="{DynamicResource s_c2c74c8a1db7}" Height="34" VerticalContentAlignment="Center" Padding="10,4" FontSize="13" Margin="0,0,0,18" KeyDown="PresetNameInput_KeyDown"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="{DynamicResource s_8fbe9b75cbdf}" Click="CancelSavePreset_Click" Padding="14,6" Margin="0,0,8,0" FontSize="12"/>
      <Button Content="{DynamicResource s_5ee521f44de9}" Click="ConfirmSavePreset_Click" Padding="14,6" Margin="0" Background="{DynamicResource AccentPrimaryBrush}" Foreground="{DynamicResource AccentPrimaryTextBrush}" BorderThickness="0" FontWeight="Bold" FontSize="12"/>
     </StackPanel>
    </StackPanel>
   </Border>
  </Grid>
 </Grid>
</Window>
