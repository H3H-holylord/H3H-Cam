<Window x:Class="S8Cam.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="H3H CAM 5.0 · CineAtelier Studio" Icon="app.ico" Width="1240" Height="920" MinWidth="980" MinHeight="680"
 Background="{DynamicResource BgWindowBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
 FontFamily="Segoe UI" FontSize="13.5" UseLayoutRounding="True" SnapsToDevicePixels="True"
 WindowStartupLocation="CenterScreen">

 <Grid x:Name="RootLayoutGrid" Margin="18" Background="{DynamicResource BgWindowBrush}">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <!-- ВЕРХНЯЯ ПРИБОРНАЯ ДЕКА (HEADER DECK) -->
  <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,12">
   <Grid>
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="Auto"/>
     <ColumnDefinition Width="*"/>
     <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    <!-- Бренд + Инстанс мультикама -->
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Border Width="40" Height="40" CornerRadius="9" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Padding="4" Margin="0,0,12,0">
      <Image Source="app.png" Stretch="Uniform"/>
     </Border>
     <StackPanel VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
       <TextBlock Text="H3H CAM" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
       <Border Background="{DynamicResource AccentSoftBgBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1" CornerRadius="5" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
        <TextBlock x:Name="InstanceBadgeText" Text="5.0 · CAM #1" FontFamily="Consolas" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
       </Border>
      </StackPanel>
      <TextBlock x:Name="HeaderSubtitleText" Text="{DynamicResource s_37ad6203a89e}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,1,0,0"/>
     </StackPanel>
    </StackPanel>

    <!-- Правая группа управления характером прибора, Мини-пультом, Мультикамом и связью -->
    <WrapPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
     <Button x:Name="ThemeToggleButton" Content="🌙 CINE RIG" Click="ThemeToggle_Click" Padding="10,6" Margin="0,2,6,2"
             Background="{DynamicResource AccentSoftBgBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" Foreground="{DynamicResource AccentPrimaryBrush}" FontWeight="SemiBold" FontSize="11.5"
             ToolTip="Мгновенное переключение характера интерфейса: тёмный киномонитор Cine Rig ↔ светлый прибор Nordic Atelier"/>
     <Button x:Name="MiniModeButton" Content="⧉ МИНИ-ПУЛЬТ" Click="MiniMode_Click" Padding="10,6" Margin="0,2,6,2"
             FontSize="11.5" FontWeight="SemiBold"
             ToolTip="Компактный режиссёрский мини-пульт поверх всех окон (16:9 монитор, Tally, VU-метр, объективы и Focus Pull)"/>
     <Button x:Name="DualCamButton" Content="+ КАМЕРА #2" Click="LaunchSecondCamera_Click" Padding="10,6" Margin="0,2,8,2"
             FontSize="11.5" ToolTip="Запустить второе независимое окно H3H CAM со сдвинутыми портами и отдельным каналом Spout2 для съёмки с двух телефонов"/>

     <StackPanel x:Name="HeaderAuxControlsPanel" Orientation="Horizontal" VerticalAlignment="Center">
      <ComboBox x:Name="LanguageChoice" Width="106" Margin="0,2,6,2" Padding="8,5" FontSize="11.5" SelectionChanged="LanguageChoice_Changed" ToolTip="{DynamicResource language_label}">
       <ComboBoxItem Content="{DynamicResource language_auto}"/>
       <ComboBoxItem Content="Русский"/>
       <ComboBoxItem Content="English"/>
      </ComboBox>
      <Button Content="?" Click="ConnectionGuide_Click" Padding="9,6" Margin="0,2,6,2" FontSize="11.5" ToolTip="{DynamicResource setup_help}"/>
      <Button x:Name="ModeToggleButton" Content="{DynamicResource s_45e2a6940134}" Click="ModeToggle_Click" Padding="11,6" Margin="0,2,8,2"
              Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" Foreground="{DynamicResource AccentPrimaryBrush}" FontWeight="SemiBold" FontSize="11.5" ToolTip="{DynamicResource s_ab483afe53b9}"/>
     </StackPanel>

     <Border x:Name="HeaderConnectionBadge" Background="{DynamicResource AccentLiveSoftBgBrush}" BorderBrush="{DynamicResource AccentLiveBrush}" BorderThickness="1" CornerRadius="14" Padding="13,6" Margin="0,2,0,2" VerticalAlignment="Center">
      <TextBlock x:Name="ConnectionLabel" Text="{DynamicResource s_b37981243396}" Foreground="{DynamicResource AccentLiveBrush}" FontSize="12" FontWeight="SemiBold"/>
     </Border>
    </WrapPanel>
   </Grid>
  </Border>

  <!-- ПАНЕЛЬ БЫСТРЫХ СТУДИЙНЫХ ПРОФИЛЕЙ -->
  <Border x:Name="ProPresetBar" Grid.Row="1" Margin="0,0,0,12" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="12,7">
   <Grid>
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="Auto"/>
     <ColumnDefinition Width="*"/>
     <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <TextBlock Text="{DynamicResource s_59dd689c927a}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
    <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <Button x:Name="PresetStreamingBtn" Content="{DynamicResource s_81972542b0e4}" Click="PresetStreaming_Click" Padding="9,5" Margin="0,2,6,2" FontSize="11.5" ToolTip="{DynamicResource s_697c7d0f0e9f}"/>
     <Button x:Name="PresetConferenceBtn" Content="{DynamicResource s_661451c0f114}" Click="PresetConference_Click" Padding="9,5" Margin="0,2,6,2" FontSize="11.5" ToolTip="{DynamicResource s_42894855e9d4}"/>
     <Button x:Name="PresetProBtn" Content="{DynamicResource s_82d205c49029}" Click="PresetPro_Click" Padding="9,5" Margin="0,2,6,2" FontSize="11.5" ToolTip="{DynamicResource s_ce2b3c13f7d8}"/>
     <Button x:Name="PresetEcoBtn" Content="{DynamicResource s_fbd463595a6a}" Click="PresetEco_Click" Padding="9,5" Margin="0,2,8,2" FontSize="11.5" ToolTip="{DynamicResource s_49c98556ff02}"/>

     <Border Width="1" Height="20" Background="{DynamicResource BorderSubtleBrush}" Margin="2,2,10,2" VerticalAlignment="Center"/>

     <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,2">
      <ComboBox x:Name="CustomPresetsCombo" MinWidth="145" MaxWidth="215" Margin="0,0,6,0" Padding="8,4" FontSize="11.5" SelectionChanged="CustomPresetsCombo_SelectionChanged" ToolTip="{DynamicResource s_2d48d84c8597}"/>
      <Button x:Name="SavePresetButton" Content="{DynamicResource s_5ee521f44de9}" Click="SavePreset_Click" Padding="9,5" Margin="0,0,4,0" Background="{DynamicResource AccentSoftBgBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" Foreground="{DynamicResource AccentPrimaryBrush}" FontSize="11.5" ToolTip="{DynamicResource s_321a918f37f8}"/>
      <Button x:Name="DeletePresetButton" Content="🗑️" Click="DeletePreset_Click" Padding="8,5" Margin="0,0,4,0" Background="{DynamicResource AccentTallySoftBgBrush}" BorderBrush="{DynamicResource AccentTallyBrush}" Foreground="{DynamicResource AccentTallyBrush}" FontSize="11.5" ToolTip="{DynamicResource s_b2f3309e95ed}"/>
     </StackPanel>
    </WrapPanel>
    <Button Grid.Column="2" Content="{DynamicResource s_1423783c8125}" Click="OptimizeObs_Click" Padding="10,5" Margin="0" FontSize="11.5" ToolTip="{DynamicResource s_a5972886b2f5}"/>
   </Grid>
  </Border>

  <!-- ОСНОВНАЯ РАБОЧАЯ СЦЕНА -->
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions>
    <ColumnDefinition x:Name="LeftPaneColumn" Width="1.02*"/>
    <ColumnDefinition x:Name="CenterGapColumn" Width="14"/>
    <ColumnDefinition x:Name="RightMonitorColumn" Width="1.20*"/>
   </Grid.ColumnDefinitions>

   <!-- ЛЕВАЯ КОЛОНКА: ПУЛЬТ НАСТРОЕК (Базовый или Студийный Pro) -->
   <Border x:Name="LeftControlBorder" Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="14" Padding="13">
    <Grid>
     <!-- 1. Базовый режим (Basic Mode) -->
     <ScrollViewer x:Name="BasicPanel" VerticalScrollBarVisibility="Auto" Padding="2,2,6,2" Visibility="Collapsed">
      <StackPanel>
       <Border Background="{DynamicResource BgCardBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,12" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
        <StackPanel>
         <DockPanel Margin="0,0,0,6">
          <TextBlock Text="{DynamicResource s_9ba5c8df7afa}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center"/>
          <Border Background="{DynamicResource AccentSoftBgBrush}" CornerRadius="5" Padding="7,2" HorizontalAlignment="Right">
           <TextBlock x:Name="BasicTransportBadge" Text="{DynamicResource s_06dd749dee7f}" Foreground="{DynamicResource AccentPrimaryBrush}" FontSize="10.5" FontWeight="SemiBold"/>
          </Border>
         </DockPanel>
         <TextBlock x:Name="BasicDeviceNameText" Text="{DynamicResource s_3582cbf15fc8}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
         <TextBlock x:Name="BasicBatteryText" Text="{DynamicResource s_78f56579d505}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,2"/>
         <TextBlock x:Name="BasicTransportText" Text="{DynamicResource s_befdd34ad631}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
       </Border>

       <TextBlock Text="{DynamicResource s_91da50927c06}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,2,0,4"/>
       <ComboBox x:Name="BasicTransportChoice" SelectedIndex="{Binding SelectedIndex, ElementName=Transport, Mode=TwoWay}" Margin="0,2,0,8">
        <ComboBoxItem Content="{DynamicResource s_81e310817a26}"/>
        <ComboBoxItem Content="{DynamicResource s_42d4da83ae55}"/>
        <ComboBoxItem Content="{DynamicResource s_88d6f0e4a586}"/>
        <ComboBoxItem Content="{DynamicResource s_6d50ae7c1e98}"/>
       </ComboBox>
       <TextBox Text="{Binding Text, ElementName=PhoneIp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" ToolTip="{DynamicResource s_03be1fd3bd6e}">
        <TextBox.Style>
         <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Style.Triggers>
           <DataTrigger Binding="{Binding SelectedIndex, ElementName=Transport}" Value="1">
            <Setter Property="Visibility" Value="Visible"/>
           </DataTrigger>
          </Style.Triggers>
         </Style>
        </TextBox.Style>
       </TextBox>
       <Button Content="{DynamicResource s_4f2ca7cc3bf7}" Click="Scan_Click" IsEnabled="{Binding IsEnabled, ElementName=ScanButton}" HorizontalAlignment="Stretch" Margin="0,0,0,6"/>
       <TextBlock Text="{Binding Text, ElementName=DeviceHint}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,12"/>

       <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,12">
        <StackPanel>
         <TextBlock Text="{DynamicResource setup_title}" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
         <TextBlock x:Name="ConnectionHelpText" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,8"/>
         <Button Content="{DynamicResource setup_connect}" Click="QuickConnect_Click" IsEnabled="{Binding IsEnabled, ElementName=ScanButton}" Margin="0,0,0,6"/>
         <Button Content="{DynamicResource setup_qr}" Click="ShowQr_Click" Margin="0"/>
        </StackPanel>
       </Border>

       <StackPanel x:Name="BasicCameraSettings" Visibility="Collapsed">
        <TextBlock Text="{DynamicResource s_5d6f264e301f}" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <ComboBox x:Name="BasicCameraChoice" DisplayMemberPath="DisplayLabel" SelectedValuePath="Key" SelectionChanged="BasicCameraChoice_Changed" Margin="0,0,0,8"/>

        <TextBlock Text="{DynamicResource s_7f7637a13b77}" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <UniformGrid Columns="2" Margin="0,0,0,12">
         <RadioButton x:Name="BasicOrientation169" Content="{DynamicResource s_2bcc778d3619}" GroupName="BasicOrientation" Checked="BasicOrientation_Checked" FontSize="12" Padding="4,0,0,0"/>
         <RadioButton x:Name="BasicOrientation916" Content="📱 9:16 Shorts" GroupName="BasicOrientation" Checked="BasicOrientation_Checked" FontSize="12" Padding="4,0,0,0"/>
        </UniformGrid>

        <TextBlock Text="{DynamicResource s_abca38be83a6}" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <UniformGrid Columns="2" Margin="0,0,0,12">
         <Button Content="{DynamicResource s_2b89b1281e84}" Click="PresetStreaming_Click" Padding="8,7" Margin="0,0,4,4" FontSize="11.5"/>
         <Button Content="{DynamicResource s_2066a9ebe9e5}" Click="PresetConference_Click" Padding="8,7" Margin="4,0,0,4" FontSize="11.5"/>
         <Button Content="{DynamicResource s_619076f05638}" Click="PresetPro_Click" Padding="8,7" Margin="0,4,4,0" FontSize="11.5"/>
         <Button Content="{DynamicResource s_eaa59b65b98b}" Click="PresetEco_Click" Padding="8,7" Margin="4,4,0,0" FontSize="11.5"/>
        </UniformGrid>

        <TextBlock Text="{DynamicResource s_5bc7ae052743}" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <CheckBox x:Name="BasicPreviewCheck" Content="{DynamicResource s_21c8b6e6cc75}" IsChecked="{Binding IsChecked, ElementName=Preview, Mode=TwoWay}"/>
        <CheckBox Content="{DynamicResource s_0076726a226c}" IsChecked="{Binding IsChecked, ElementName=ScreenOff, Mode=TwoWay}"/>
        <CheckBox x:Name="BasicMicCheck" Content="🎙️ Использовать микрофон смартфона" IsChecked="{Binding IsChecked, ElementName=AudioEnabledCheck, Mode=TwoWay}"/>
        <CheckBox x:Name="BasicVirtualCamCheck" Content="{DynamicResource s_0a713151cdca}" Click="BasicVirtualCam_Click"/>
        <TextBlock Text="{Binding Text, ElementName=VirtualCamStatusText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="24,-2,0,8"/>
        <Button Content="{Binding Content, ElementName=InstallVirtualCamButton}" Visibility="{Binding Visibility, ElementName=InstallVirtualCamButton}" IsEnabled="{Binding IsEnabled, ElementName=InstallVirtualCamButton}" Click="InstallVirtualCam_Click" HorizontalAlignment="Left" Padding="10,5" Margin="24,0,0,8"/>
        <CheckBox x:Name="BasicSpoutCheck" Content="{DynamicResource s_083c3e6a77fc}" Click="BasicSpout_Click"/>
        <CheckBox x:Name="BasicFaceTrackingCheck" Content="{DynamicResource s_0cdbf83a8925}" Click="BasicFaceTracking_Click"/>
        <CheckBox x:Name="BasicStabilizationCheck" Content="{DynamicResource s_dfa78d932025}" Click="BasicStabilization_Click" Margin="0,4,0,4"/>
        <CheckBox x:Name="BasicSuperSteadyCheck" Content="{DynamicResource s_5e99808b4b3f}" Click="BasicSuperSteady_Click" Margin="20,0,0,12" ToolTip="{DynamicResource s_9fbacf088232}"/>
       </StackPanel>

       <Button x:Name="BasicStartButton" Content="{DynamicResource s_9825166bb975}" Height="46"
               Background="{DynamicResource AccentPrimaryBrush}" Foreground="{DynamicResource AccentPrimaryTextBrush}" BorderThickness="0"
               FontWeight="Bold" FontSize="15" Click="BasicStart_Click" Margin="0,2,0,8"/>

       <Button Content="{DynamicResource s_b14653ac00f1}" Click="ModeToggle_Click" Background="Transparent" Foreground="{DynamicResource AccentPrimaryBrush}" BorderThickness="0" HorizontalAlignment="Center" FontSize="12" Margin="0,2,0,4"/>
      </StackPanel>
     </ScrollViewer>

     <!-- 2. Расширенный студийный режим (Pro Mode · 6 вкладок) -->
     <TabControl x:Name="SettingsPanel">

      <!-- Вкладка 0: 🔌 Связь -->
      <TabItem Header="{DynamicResource s_76181f21a3f9}">
       <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="2,10,6,0">
        <StackPanel>
         <TextBlock Text="{DynamicResource s_879f5d0dc770}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>

         <TextBlock Text="{DynamicResource s_e9ea7558b557}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
         <ComboBox x:Name="Transport">
          <ComboBoxItem Content="{DynamicResource s_8776befa2026}"/>
          <ComboBoxItem Content="Wi-Fi · RTP"/>
          <ComboBoxItem Content="{DynamicResource s_48b7281e0873}"/>
          <ComboBoxItem Content="{DynamicResource s_c3ce7edb8574}"/>
         </ComboBox>

         <TextBlock Text="{DynamicResource s_822f9fd9ba2d}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <ComboBox x:Name="DeviceChoice" DisplayMemberPath="Label" SelectedValuePath="Key" Margin="0,4,8,10"/>
          <Button Grid.Column="1" x:Name="ScanButton" Content="{DynamicResource s_1527932a67cd}" Click="Scan_Click" Margin="0,4,0,10" Padding="15,7"/>
         </Grid>
         <TextBlock x:Name="DeviceHint" Text="{DynamicResource s_742e0018a139}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,-4,4,10"/>

         <CheckBox x:Name="ScreenOff" Content="{DynamicResource s_ea934cc99add}"/>

         <DockPanel Margin="0,0,0,4">
          <Button x:Name="InstallVirtualCamButton" Content="{DynamicResource s_9cfff5dad91d}" Click="InstallVirtualCam_Click" DockPanel.Dock="Right" Padding="10,4" Margin="6,0,0,0" FontSize="11" Visibility="Collapsed"/>
          <CheckBox x:Name="VirtualCamera" Content="{DynamicResource s_e4185855dc30}" Click="VirtualCamera_Click" VerticalAlignment="Center"/>
         </DockPanel>
         <TextBlock x:Name="VirtualCamStatusText" Text="{DynamicResource s_6505f9c93157}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="24,-2,0,8" TextWrapping="Wrap"/>

         <CheckBox x:Name="Preview" Content="{DynamicResource s_f3f1f28d95ee}" Checked="Preview_Changed" Unchecked="Preview_Changed" Margin="0,0,0,8"/>

         <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="9" Padding="11" Margin="0,4,0,10">
          <StackPanel>
           <TextBlock Text="{DynamicResource s_64c19913330d}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,0,0,6"/>
           <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,4,0"><TextBlock Text="{DynamicResource s_d9e4185810dc}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBox x:Name="PhoneIp"/></StackPanel>
            <StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBlock Text="{DynamicResource s_d343cbabc004}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBox x:Name="PcIp" Margin="0,4,0,10"/></StackPanel>
           </Grid>
           <DockPanel Margin="0,2,0,2">
            <Button x:Name="ShowQrButton" Content="{DynamicResource s_814c58d9243b}" Click="ShowQr_Click" DockPanel.Dock="Right" Padding="12,5" FontSize="11.5" Margin="6,0,0,0"/>
            <CheckBox x:Name="AutoPcIp" Content="{DynamicResource s_d5b19baa4e01}" Checked="AutoPcIp_Changed" Unchecked="AutoPcIp_Changed" VerticalAlignment="Center"/>
           </DockPanel>
          </StackPanel>
         </Border>

         <TextBlock Text="{DynamicResource s_6ebb7213dc40}" FontSize="13.5" FontWeight="SemiBold" Margin="0,2,0,6"/>
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,3,0"><TextBlock Text="{DynamicResource s_13cbfd09104d}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBox x:Name="RtpPort"/></StackPanel>
          <StackPanel Grid.Column="1" Margin="3,0,3,0"><TextBlock Text="{DynamicResource s_731d215ad94f}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBox x:Name="UsbPort"/></StackPanel>
          <StackPanel Grid.Column="2" Margin="3,0,0,0"><TextBlock Text="{DynamicResource s_356707664ea3}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBox x:Name="ObsPort" Margin="0,4,0,10"/></StackPanel>
         </Grid>

         <TextBlock Text="{DynamicResource s_b1063d2f3130}" FontSize="13.5" FontWeight="SemiBold" Margin="0,6,0,4"/>
         <CheckBox x:Name="AutoReconnect" Content="{DynamicResource s_856dd46c55d5}" ToolTip="{DynamicResource s_7c28e9eb31d7}"/>
         <CheckBox x:Name="AutoStartOnUsb" Content="{DynamicResource s_b49e97487170}"/>
         <CheckBox x:Name="AutoStart" Content="{DynamicResource s_70c29912bad6}"/>
        </StackPanel>
       </ScrollViewer>
      </TabItem>

      <!-- Вкладка 1: 🎥 Камера -->
      <TabItem Header="{DynamicResource s_e9832701f265}">
       <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="2,10,6,0">
        <StackPanel>
         <TextBlock Text="{DynamicResource s_094a5a7154ee}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>

         <TextBlock Text="{DynamicResource s_05b653a0de26}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
         <ComboBox x:Name="CameraChoice" DisplayMemberPath="DisplayLabel" SelectedValuePath="Key" SelectionChanged="CameraChoice_Changed"/>
         <TextBlock x:Name="CameraHint" Text="{DynamicResource s_3b4ff0e8a258}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,-2,4,8"/>

         <TextBlock Text="{DynamicResource camera_api_label}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
         <ComboBox x:Name="CameraApiChoice" ToolTip="{DynamicResource camera_api_tooltip}" Margin="0,4,0,10">
          <ComboBoxItem Content="{DynamicResource camera_api_auto}"/>
          <ComboBoxItem Content="{DynamicResource camera_api_camera2}"/>
          <ComboBoxItem Content="{DynamicResource camera_api_camera1}"/>
         </ComboBox>

         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,4,0"><TextBlock Text="{DynamicResource s_adc3b01f3c15}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/><ComboBox x:Name="ResolutionChoice" DisplayMemberPath="Label" SelectionChanged="ResolutionChoice_Changed"/></StackPanel>
          <StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBlock Text="{DynamicResource s_f92764cb0017}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/><ComboBox x:Name="Fps" Margin="0,4,0,10"/></StackPanel>
         </Grid>

         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,4,0"><TextBlock Text="{DynamicResource s_fae9840fa218}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBox x:Name="Bitrate"/></StackPanel>
          <StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBlock Text="{DynamicResource s_70929885dcb0}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/><ComboBox x:Name="CodecChoice" Margin="0,4,0,10">
           <ComboBoxItem Content="{DynamicResource s_f3850b70ea14}"/>
           <ComboBoxItem Content="{DynamicResource s_bfb8c902ff60}"/>
          </ComboBox></StackPanel>
         </Grid>

         <Grid Margin="0,2,0,6">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,4,0"><TextBlock Text="{DynamicResource s_2b180be62e35}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/><ComboBox x:Name="ZoomChoice">
           <ComboBoxItem Content="{DynamicResource s_5f433d45971d}"/>
           <ComboBoxItem Content="1.2x"/>
           <ComboBoxItem Content="1.5x"/>
           <ComboBoxItem Content="2.0x"/>
           <ComboBoxItem Content="3.0x"/>
          </ComboBox></StackPanel>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,16,0,0">
