            <TextBlock x:Name="AudioGainText" Text="0.0 дБ" FontFamily="Consolas" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" HorizontalAlignment="Right"/>
           </DockPanel>
           <Slider x:Name="AudioGainSlider" Minimum="-24" Maximum="24" Value="0" SmallChange="1" LargeChange="3" ValueChanged="AudioSliders_ValueChanged" Margin="0,2,0,8"/>

           <!-- Задержка Lip-Sync -->
           <DockPanel Margin="0,0,0,2">
            <TextBlock Text="Задержка синхронизации с видео (Lip-Sync)" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock x:Name="AudioDelayText" Text="45 мс" FontFamily="Consolas" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" HorizontalAlignment="Right"/>
           </DockPanel>
           <Slider x:Name="AudioDelaySlider" Minimum="0" Maximum="500" Value="45" SmallChange="5" LargeChange="25" ValueChanged="AudioSliders_ValueChanged" Margin="0,2,0,8"/>

           <CheckBox x:Name="AudioMonitorCheck" Content="Выводить звук в Windows (динамики / VB-Cable для OBS и Zoom)" IsChecked="True"/>

           <TextBlock Text="Устройство вывода звука Windows:" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
           <Grid Margin="0,4,0,6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="AudioDeviceChoice" DisplayMemberPath="Name" Margin="0,0,6,0"/>
            <Button Grid.Column="1" Content="↻" Click="RefreshAudioDevices_Click" Padding="10,5" Margin="0" ToolTip="Обновить список аудиоустройств Windows"/>
           </Grid>

           <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
            <TextBlock Text="Совет: выберите VB-Cable Input, чтобы подать микрофон телефона в OBS, Discord или Zoom." FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <StackPanel Grid.Column="1">
             <TextBlock Text="Аудиопорт UDP/TCP" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"/>
             <TextBox x:Name="AudioPortBox" Text="5004" Margin="0,2,0,0"/>
            </StackPanel>
           </Grid>
          </StackPanel>
         </Border>

         <!-- 2. OBS WEBSOCKET V5 & МУЛЬТИКАМ -->
