<Window x:Class="S8Cam.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="H3H Cam • Live Preview" Icon="app.ico" Width="960" Height="580" MinWidth="480" MinHeight="320"
        Background="#060B12" Foreground="#E7F0FF" WindowStartupLocation="CenterScreen">
    <Grid MouseWheel="VideoPreview_MouseWheel">
        <Image x:Name="LivePreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality"
               MouseDown="VideoPreview_MouseDown" MouseWheel="VideoPreview_MouseWheel" Cursor="Cross"/>
        <Canvas x:Name="FocusCanvas" ClipToBounds="True" IsHitTestVisible="False"/>
        <Canvas x:Name="GridCanvas" ClipToBounds="True" IsHitTestVisible="False" Visibility="Collapsed" SizeChanged="GridCanvas_SizeChanged"/>

        <DockPanel VerticalAlignment="Top" Margin="12,10,12,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Border Background="#D9090F1A" CornerRadius="4" Padding="8,3" Margin="0,0,6,0">
                    <TextBlock x:Name="ResolutionBadge" Text="1920×1080" Foreground="#70E5C3" FontSize="11" FontWeight="SemiBold"/>
                </Border>
                <Border x:Name="RecBadgeBorder" Visibility="Collapsed" Background="#D9E02424" CornerRadius="4" Padding="8,3">
                    <TextBlock x:Name="RecBadgeText" Text="🔴 REC 00:00" Foreground="White" FontSize="11" FontWeight="Bold"/>
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SnapshotButton" Content="📸 СНИМОК" Padding="8,3" Margin="0,0,6,0" Click="Snapshot_Click" Background="#1C2E42" Foreground="#70E5C3" FontSize="11" ToolTip="Моментальный 4K/UHD снимок в папку Изображения/H3HCam (F9 / Ctrl+S)"/>
                <Button x:Name="RecordButton" Content="🔴 ЗАПИСЬ" Padding="8,3" Margin="0,0,8,0" Click="Record_Click" Background="#2A141A" Foreground="#FF6B8B" FontSize="11" ToolTip="Локальная запись прямого MP4-потока без нагрузки на процессор (F10 / Ctrl+R)"/>
                <Button x:Name="GridButton" Content="📐 GRID" Padding="8,3" Margin="0,0,8,0" Click="Grid_Click" Background="#152435" Foreground="#8498B4" FontSize="11" ToolTip="Направляющие сетки композиции (Rule of Thirds / 9:16)"/>
                <Button x:Name="PeakButton" Content="🔍 PEAK" Padding="8,3" Margin="0,0,8,0" Click="Peak_Click" Background="#152435" Foreground="#8498B4" FontSize="11" ToolTip="Focus Peaking: подсветка контуров резкости"/>
                <Button x:Name="ZebraButton" Content="🦓 ZEBRA" Padding="8,3" Margin="0,0,8,0" Click="Zebra_Click" Background="#152435" Foreground="#8498B4" FontSize="11" ToolTip="Zebra Pattern: индикатор зон пересвета"/>
                <Button x:Name="LockAeAwbButton" Content="🔓 AE/AWB" Padding="8,3" Margin="0,0,8,0" Click="LockAeAwb_Click" Background="#152435" Foreground="#8498B4" FontSize="11" ToolTip="Быстрая фиксация/разблокировка автоэкспозиции и баланса белого"/>
                <TextBlock Text="🎯 Клик: фокус  ·  Колёсико: зум  ·  Ср. клик / 2x: 1.0x  ·  F11: Полный экран" Foreground="#8498B4" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button Content="⛶ Полный экран" Padding="10,3" Click="Fullscreen_Click" Background="#1C2E42" Foreground="#E7F0FF" FontSize="11"/>
            </StackPanel>
        </DockPanel>

        <!-- Вспышка затвора при создании снимка -->
        <Border x:Name="CameraFlashOverlay" Background="White" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
    </Grid>
</Window>
